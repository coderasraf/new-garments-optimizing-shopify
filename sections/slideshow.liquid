    </svg>
              
                  </span>
                  <span class="stars_kopstorm_wrap">
                     
                <svg aria-hidden="true" width="58" height="58" viewBox="0 0 58 58" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M25.698 2.33944C26.5742 -0.427463 30.4774 -0.46152 31.4017 2.28967L36.2188 16.6265C36.6292 17.8481 37.7739 18.671 39.0626 18.671H54.0339C56.8307 18.671 58.1061 22.1605 55.9684 23.964L43.7781 34.2488C42.8785 35.0079 42.5058 36.2229 42.8252 37.3558L47.3227 53.3075C48.1005 56.0662 44.9369 58.2403 42.6403 56.5254L30.3859 47.3747C29.3068 46.569 27.823 46.581 26.7572 47.4042L15.0419 56.4522C12.7791 58.1999 9.58616 56.0918 10.3044 53.3243L14.4636 37.2973C14.75 36.1936 14.386 35.023 13.5242 34.2763L1.59196 23.9384C-0.507153 22.1198 0.779029 18.671 3.55638 18.671H18.3292C19.6372 18.671 20.7944 17.8237 21.1892 16.5768L25.698 2.33944Z" fill="#252427"></path>
    </svg>
              
                  </span>
                    </div>
                  <span class="star_label">{{ block.settings.rating_text }}</span>
