{%- liquid
  assign isModal = false
  if template == 'product.modal'
    assign isModal = true
  endif
-%}

{%- render 'product-template',
  product: product,
  section_id: section.id,
  blocks: section.blocks,
  image_position: section.settings.image_position,
  image_container_width: section.settings.image_size,
  product_zoom_enable: section.settings.product_zoom_enable,
  sku_enable: section.settings.sku_enable,
  isModal: isModal,
  thumbnail_position: section.settings.thumbnail_position,
  thumbnail_height: section.settings.thumbnail_height,
  thumbnail_arrows: section.settings.thumbnail_arrows,
  mobile_layout: section.settings.mobile_layout,
  video_looping: section.settings.enable_video_looping,
  video_style: section.settings.product_video_style,
  context: 'main-product',
-%}

<style>
  div.swatch-preset-934360 .swatch-drop-down {
    min-width: 100% !important;
    display:flex !important;
}
  .dynamic-icons-section {
    display: block;
}

.center.prod_icons {
    padding-top: 15px;
}
  .swatch-single {
    margin-bottom: 20px;
}

button.cbb-frequently-bought-add-button.btn.add-to-cart {
    border: none !important;
}

.cbb-frequently-bought-container.cbb-desktop-view {
    border: 1px solid #ddd;
    padding: 15px;
    border-radius: 8px;
}

.swatch-drop-down-wrapper.swatch-drop-down-custom {
    margin-left: 0 !important;
}



@media(min-width:769px){
.model-size-text {
    display: none;
}
}

@media(max-width:768px){
.page-content--product .flickity-page-dots {
    bottom: 25px;
}
    .product__main-photos {
      margin-bottom:0;
    }
    .model_text-destiop {
    display: none;
}
}



{% comment %} Rewriting Style {% endcomment %}
 .custom-shipping-container {
    display: none;
}

div#dynamic-social-proof {
    display: none;
}


ul.inline-list.payment-icons.footer__section.pay-btn {
    display: none;
}

.review-badge-c {
    display: none;
}
span.product__price {
    font-size: 18px;
    color: #000;
}

.variant-input-wrap label {
    border-radius: 0;
    background: #e5e5e5;
}

.variant-input-wrap input[type=radio]:checked+label {
    background: #000;
    color: #fff;
}
button.btn.btn--full.add-to-cart{
  box-shadow:none;
}
.product-single__meta {
    text-align: center;
}

{% comment %} .product-block.product-block--price {border-bottom: none;margin-bottom: 10px;}
.collapsibles-wrapper.collapsibles-wrapper--border-bottom {
    background: #E5E5E5;
    border: none;
}
[data-center-text=true] .collapsible-trigger-btn {
    text-align: left;
} {% endcomment %}

[data-center-text=true] .collapsible-trigger-btn {
    text-align: left;
}
[data-center-text=true] .collapsible-trigger-btn {
    text-align: left;
    letter-spacing: 1px;
    font-size: 13px;
    font-weight: 700;
}
.collapsible-trigger-btn--borders{
border:none;
}
.collapsibles-wrapper.collapsibles-wrapper--border-bottom {
    border-bottom: none;
    background: #E5E5E5;
    margin-bottom: 30px !important;
}
.product-block.product-block--price {
    border-bottom: none;
    margin-bottom: 10px;
}
.page-content--product {
    padding-top: 0;
}

.product__thumbs--below .product__thumb-item {
    display: inline-block;
    margin-right: 5.5px;
    max-width: 62px !important;
}

.model_text-destiop {
    margin-top: 10px;
    text-transform: uppercase;
}

@media(max-width:768px){
.product__main-photos .flickity-page-dots{
  display:none;
}
.product__thumbs.product__thumbs--below {
    display: block !important;
}
h1.h2.product-single__title {
    font-size: 18px;
    font-weight: bold;
    text-align: center;
}

span.product__price {
    font-size: 18px;
    font-weight: normal;
}

.product-single__meta {
    text-align: center !important;
    margin-top: 20px;
}
.product__thumb-arrow {
    display: none;
}

.model-size-text {
    display: block;
}
.model-size-text {
    background: #e5e5e5;
    text-align: center;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 6px 0;
}

.model-size-text p {
    margin: 0;
}
}
button.btn.cart__checkout{
  box-shadow:none;
}
</style>



