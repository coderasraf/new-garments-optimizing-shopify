<style>
.photo-reviews { padding: 40px 0; background: #fff; }
.photo-reviews__title { text-align: center; font-size: 1.5em; font-weight: 700; margin-bottom: 8px; text-transform: uppercase; letter-spacing: 0.05em; }
.photo-reviews__subtitle { text-align: center; font-size: 0.9em; color: #888; margin-bottom: 24px; }
.photo-reviews__grid { display: flex; gap: 12px; overflow-x: scroll; padding: 0 16px 12px; -webkit-overflow-scrolling: touch; touch-action: pan-x; scrollbar-width: none; cursor: grab; }
.photo-reviews__grid::-webkit-scrollbar { display: none; }
.photo-reviews__card { flex: 0 0 280px; background: #fafafa; border-radius: 12px; overflow: hidden; box-shadow: 0 1px 8px rgba(0,0,0,0.06); touch-action: pan-x; }
.photo-reviews__img { width: 100%; height: 280px; object-fit: cover; display: block; }
.photo-reviews__body { padding: 14px 16px; }
.photo-reviews__stars { color: #000; font-size: 14px; letter-spacing: 2px; margin-bottom: 6px; }
.photo-reviews__text { font-size: 13px; line-height: 1.5; color: #333; margin-bottom: 10px; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
.photo-reviews__author { display: flex; align-items: center; gap: 8px; }
.photo-reviews__avatar { width: 28px; height: 28px; border-radius: 50%; background: #222; color: #fff; display: flex; align-items: center; justify-content: center; font-size: 11px; font-weight: 700; }
.photo-reviews__name { font-size: 12px; font-weight: 600; color: #333; }
.photo-reviews__verified { font-size: 10px; color: #999; }
.photo-reviews__badge { display: inline-block; font-size: 9px; color: #666; font-weight: 600; margin-left: 4px; }
@media (max-width: 749px) { .photo-reviews__card { flex: 0 0 240px; } .photo-reviews__img { height: 240px; } }
</style>

{% if section.blocks.size > 0 %}
<div class="photo-reviews">
  {% if section.settings.title != blank %}
    <h2 class="photo-reviews__title">{{ section.settings.title }}</h2>
  {% endif %}
  {% if section.settings.subtitle != blank %}
    <p class="photo-reviews__subtitle">{{ section.settings.subtitle }}</p>
  {% endif %}
  <div class="photo-reviews__grid">
    {% for block in section.blocks %}
      <div class="photo-reviews__card" {{ block.shopify_attributes }}>
        {% if block.settings.image_url != blank %}
          <img class="photo-reviews__img" src="{{ block.settings.image_url }}" alt="Customer review" loading="lazy">
        {% endif %}
        <div class="photo-reviews__body">
          <div class="photo-reviews__stars">
            {% for i in (1..5) %}{% if i <= block.settings.rating %}&#9733;{% else %}&#9734;{% endif %}{% endfor %}
          </div>
          {% if block.settings.review_text != blank %}
            <p class="photo-reviews__text">{{ block.settings.review_text }}</p>
          {% endif %}
          <div class="photo-reviews__author">
            <div class="photo-reviews__avatar">{{ block.settings.author | slice: 0, 2 | upcase }}</div>
            <div>
              <div class="photo-reviews__name">{{ block.settings.author }} <span class="photo-reviews__badge">&#10003; Verified</span></div>
              <div class="photo-reviews__verified">{{ block.settings.location }}</div>
            </div>
          </div>
        </div>
      </div>
    {% endfor %}
  </div>
</div>
{% endif %}


<script>
document.addEventListener("DOMContentLoaded", function() {
  var grid = document.querySelector('.photo-reviews__grid');
  if (!grid) return;
  var isDragging = false, startX, scrollLeft;
  grid.addEventListener('mousedown', function(e) {
    isDragging = false;
    startX = e.pageX - grid.offsetLeft;
    scrollLeft = grid.scrollLeft;
  });
  grid.addEventListener('mousemove', function(e) {
    if (e.buttons !== 1) return;
    isDragging = true;
    grid.scrollLeft = scrollLeft - ((e.pageX - grid.offsetLeft) - startX) * 2;
  });
  grid.addEventListener('touchstart', function(e) {
    isDragging = false;
    startX = e.touches[0].pageX - grid.offsetLeft;
    scrollLeft = grid.scrollLeft;
  }, {passive: true});
  grid.addEventListener('touchmove', function(e) {
    isDragging = true;
    grid.scrollLeft = scrollLeft - ((e.touches[0].pageX - grid.offsetLeft) - startX);
  }, {passive: true});
});
</script>

{% schema %}
{
  "name": "Photo Reviews",
  "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "What Our Customers Say" },
    { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Real reviews from real customers" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "text", "id": "image_url", "label": "Image URL" },
        { "type": "range", "id": "rating", "label": "Rating", "min": 1, "max": 5, "default": 5 },
        { "type": "textarea", "id": "review_text", "label": "Review Text" },
        { "type": "text", "id": "author", "label": "Author Name" },
        { "type": "text", "id": "location", "label": "Location" }
      ]
    }
  ],
  "presets": [{ "name": "Photo Reviews" }]
}
{% endschema %}