{% capture description %}
  {%- if product.empty? -%}
    {{ 'home_page.onboarding.product_description' | t }}
  {%- else -%}
    {{ product.description }}
  {%- endif -%}
{% endcapture %}
{% capture size_chart_html %}
  {%- render 'size-chart-metafield' -%}
{% endcapture %}
{%- if is_tab -%}
  {% assign title = 'products.product.description' | t %}
  {% assign full_content = description | append: size_chart_html %}
  {%- render 'tab', id: id, title: title, content: full_content -%}
{%- else -%}
  <div class="rte">
    {{ description }}
  </div>
  {%- render 'size-chart-metafield' -%}
{%- endif -%}