<div class="rev-scroll-wrapper">
  <div class="rev-scroll-track">
    {%- for i in (1..7) -%}
      {%- assign t_key = 'title-' | append: i -%}
      {%- assign r_key = 'review-' | append: i -%}
      {%- assign n_key = 'name-' | append: i -%}
      {%- if section.settings[t_key] != blank -%}
      <div class="rev-card">
        <div class="rev-card-top">
          <img loading="lazy" width="100" src="https://cdn.shopify.com/s/files/1/0667/6869/9616/files/stars.svg?v=1667224289" alt="" class="rev-stars">
          <div class="rev-verified">
            <img src="https://cdn.shopify.com/s/files/1/0611/7461/2186/files/verified-badge.svg?v=1676968204" loading="lazy" alt="" class="rev-verified-icon">
            <span class="rev-verified-text">
              {% if localization.language.iso_code == 'de' %}Verifiziert{% elsif localization.language.iso_code == 'nl' %}Geverifieerd{% else %}Verified{% endif %}
            </span>
          </div>
        </div>
        <div class="rev-card-title">{{ section.settings[t_key] }}</div>
        <div class="rev-card-body">{{ section.settings[r_key] }}</div>
        <div class="rev-card-author">{{ section.settings[n_key] }}</div>
      </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>

<div class="rev-footer">
  <span class="rev-footer-text">
    {% if localization.language.iso_code == 'de' %}
      <b>4,7</b>/5 basierend auf <u><b>über 500 Bewertungen</b></u> Verifiziert.
    {% elsif localization.language.iso_code == 'nl' %}
      <b>4,7</b> / 5 gebaseerd op <u><b>500+ beoordelingen</b></u> Geverifieerd.
    {% else %}
      <b>4.7</b> / 5 based on <u><b>500+ reviews</b></u> Verified.
    {% endif %}
  </span>
  <img loading="lazy" style="width:90px; margin-top:10px; border-radius:0!important;" src="https://upload.wikimedia.org/wikipedia/commons/7/78/Trustpilot_Logo_%282022%29.svg">
</div>

<style>
  /* Override collapsible parent overflow that blocks horizontal scroll */
  .collapsible-content--all.is-open,
  .collapsible-content.is-open,
  .collapsible-content__inner,
  .collapsible-content__inner.rte {
    overflow: visible !important;
  }

  .rev-scroll-wrapper {
    overflow-x: scroll;
    -webkit-overflow-scrolling: touch;
    touch-action: pan-x;
    cursor: grab;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .rev-scroll-wrapper::-webkit-scrollbar { display: none; }
  .rev-scroll-wrapper:active { cursor: grabbing; }

  .rev-scroll-track {
    display: flex;
    gap: 12px;
    width: max-content;
    padding: 4px 0;
  }

  .rev-card {
    flex: 0 0 280px;
    background: #F8F9FA;
    border-radius: 4px;
    padding: 15px;
    box-shadow: 0 1px 0 0 rgb(182 196 210 / 40%);
  }

  .rev-card-top {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
    margin-bottom: 8px;
  }

  .rev-stars {
    width: 100px;
    border-radius: 0 !important;
  }

  .rev-verified {
    display: flex;
    align-items: center;
    gap: 3px;
    margin-left: 3px;
  }
  .rev-verified-icon { width: 14px; }
  .rev-verified-text { color: #6c6c85; font-size: 12px; }

  .rev-card-title {
    font-weight: 600;
    font-size: 14px;
    margin-bottom: 5px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .rev-card-body,
  .rev-card-body p {
    font-size: 13px;
    line-height: 20px;
    color: #191919;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .rev-card-author {
    color: #747474;
    font-size: 12px;
    font-weight: 700;
    margin-top: 8px;
  }

  .rev-footer {
    text-align: center;
    margin-top: 15px;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 0 50px;
  }
  .rev-footer-text {
    color: black;
    font-size: 14px;
    line-height: 1.25;
  }

  @media (max-width: 768px) {
    .rev-card { flex: 0 0 260px; }
  }
</style>

<script>
document.addEventListener("DOMContentLoaded", function() {
  const wrapper = document.querySelector('.rev-scroll-wrapper');
  if (!wrapper) return;
  let isDragging = false, startX, scrollLeft;

  wrapper.addEventListener('mousedown', (e) => {
    isDragging = false;
    startX = e.pageX - wrapper.offsetLeft;
    scrollLeft = wrapper.scrollLeft;
  });
  wrapper.addEventListener('mousemove', (e) => {
    if (e.buttons !== 1) return;
    isDragging = true;
    const x = e.pageX - wrapper.offsetLeft;
    wrapper.scrollLeft = scrollLeft - (x - startX) * 2;
  });
  wrapper.addEventListener('touchstart', (e) => {
    isDragging = false;
    startX = e.touches[0].pageX - wrapper.offsetLeft;
    scrollLeft = wrapper.scrollLeft;
  }, {passive: true});
  wrapper.addEventListener('touchmove', (e) => {
    isDragging = true;
    const x = e.touches[0].pageX - wrapper.offsetLeft;
    wrapper.scrollLeft = scrollLeft - (x - startX) * 2;
  }, {passive: true});
});
</script>
