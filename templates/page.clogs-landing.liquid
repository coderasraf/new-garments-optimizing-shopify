/* ---- scratch card ---- */
const scModal = document.getElementById('scModal');
const scCard = document.getElementById('scratchCard');
const canvas = document.getElementById('scratchCanvas');
const scClaim = document.getElementById('scratchClaim');
const scClose = document.getElementById('scClose');
const scSub = document.getElementById('scSub');
let scratching = false, revealed = unlocked, lastP = 0, painted = false;
function paintFoil() {
  const ctx = canvas.getContext('2d');
  const r = scCard.getBoundingClientRect();
  if (r.width < 2) return;
  const dpr = Math.min(window.devicePixelRatio || 1, 2);
  canvas.width = r.width * dpr; canvas.height = r.height * dpr;
  ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  ctx.globalCompositeOperation = 'source-over';
  const g = ctx.createLinearGradient(0, 0, r.width, r.height);
  g.addColorStop(0, '#E6B73E'); g.addColorStop(.42, '#F7E596'); g.addColorStop(.55, '#EFD06A'); g.addColorStop(1, '#C9971F');
  ctx.fillStyle = g; ctx.fillRect(0, 0, r.width, r.height);
  ctx.fillStyle = 'rgba(255,255,255,.16)';
  for (let i = -r.height; i < r.width; i += 22) { ctx.save(); ctx.translate(i, 0); ctx.rotate(.3); ctx.fillRect(0, -r.height, 8, r.height * 3); ctx.restore(); }
  ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
  ctx.fillStyle = 'rgba(150,110,20,.30)';
  ctx.font = '800 ' + Math.round(r.height * .72) + 'px roc, "Arial Black", sans-serif';
  ctx.save(); ctx.translate(r.width / 2, r.height / 2); ctx.rotate(-.12); ctx.fillText('WIN', 0, 0); ctx.restore();
  ctx.fillStyle = 'rgba(255,255,255,.9)';
  ctx.font = '700 ' + Math.round(r.width * .085) + 'px everett, Arial';
  ctx.fillText('SCRATCH HERE', r.width / 2, r.height / 2);
  painted = true;
}
function ptr(e) {
  const r = canvas.getBoundingClientRect();
  return { x: e.clientX - r.left, y: e.clientY - r.top };
}
function scratch(e) {
  if (!scratching || revealed) return;
  const ctx = canvas.getContext('2d');
  const p = ptr(e);
  ctx.globalCompositeOperation = 'destination-out';
  ctx.beginPath(); ctx.arc(p.x, p.y, 28, 0, Math.PI * 2); ctx.fill();
  if (performance.now() - lastP > 160) { lastP = performance.now(); checkCleared(); }
}
function checkCleared() {
  const ctx = canvas.getContext('2d');
  const img = ctx.getImageData(0, 0, canvas.width, canvas.height).data;
  let clear = 0; for (let i = 3; i < img.length; i += 40) { if (img[i] === 0) clear++; }
  if (clear / (img.length / 40) > 0.45) reveal();
}
function reveal() {
  if (revealed) return; revealed = true; unlocked = true;
  localStorage.setItem('ngc_unlocked', '1');
  if (!localStorage.getItem('ngc_win_ts')) localStorage.setItem('ngc_win_ts', Date.now());
  canvas.classList.add('gone');
  scCard.classList.add('win');
  scSub.textContent = 'You won the biggest discount — 60% off, locked for 10 min 🔥';
  scClaim.hidden = false; requestAnimationFrame(() => scClaim.classList.add('show'));
  confetti(); trackScratch();
  applyPriceState();
}
function openScratch() {
  if (unlocked || scModal.classList.contains('open')) return;
  scModal.classList.add('open'); scModal.setAttribute('aria-hidden', 'false');
  document.body.style.overflow = 'hidden';
  if (!revealed && !painted) setTimeout(paintFoil, 50);
}
function closeScratch() {
  scModal.classList.remove('open'); scModal.setAttribute('aria-hidden', 'true');
  document.body.style.overflow = '';
}
if (canvas) {
  canvas.addEventListener('pointerdown', e => { scratching = true; try { canvas.setPointerCapture(e.pointerId); } catch (_) {} scratch(e); });
  canvas.addEventListener('pointermove', scratch);
  ['pointerup', 'pointercancel'].forEach(ev => canvas.addEventListener(ev, () => { scratching = false; }));
  scClose.addEventListener('click', closeScratch);
  scModal.addEventListener('click', e => { if (e.target === scModal) closeScratch(); });
  scClaim.addEventListener('click', () => { closeScratch(); document.getElementById('buy').scrollIntoView({ behavior: 'smooth' }); });
  if (revealed) { canvas.classList.add('gone'); scClaim.hidden = false; scClaim.classList.add('show'); scCard.classList.add('win'); scSub.textContent = 'You won 60% off — unlocked 🔥'; }
}
/* trigger: open de popup zodra de bezoeker bij het product komt (1x, alleen als nog niet unlocked) */
if (!unlocked) {
  let popped = false;
