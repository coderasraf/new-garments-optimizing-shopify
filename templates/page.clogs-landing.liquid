{% layout none %}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>NEWGARMENTS — Wavey Clog | No Restock</title>
<meta name="description" content="The NEWGRMNTS Wavey Clog. Signature wave silhouette, cushioned footbed, adjustable strap. Limited drop — no restock. Free express shipping.">
<style>
/* ---- Brand fonts (newgarments.store) ---- */
@font-face{font-family:"everett";src:url('https://www.vicinityclo.de/cdn/shop/t/177/assets/Everett-Light.woff2?v=178258735604406726951760105106') format("woff2");font-weight:300;font-style:normal;font-display:swap}
@font-face{font-family:"everett";src:url('https://www.vicinityclo.de/cdn/shop/t/177/assets/Everett-Regular.woff2?v=133912816607792724571760105108') format("woff2");font-weight:400;font-style:normal;font-display:swap}
@font-face{font-family:"everett";src:url('https://www.vicinityclo.de/cdn/shop/t/177/assets/Everett-Medium.woff2?v=48720387712956866881760105107') format("woff2");font-weight:500;font-style:normal;font-display:swap}
@font-face{font-family:"everett";src:url('https://www.vicinityclo.de/cdn/shop/t/177/assets/Everett-Medium.woff2?v=48720387712956866881760105107') format("woff2");font-weight:700;font-style:normal;font-display:swap}
@font-face{font-family:"roc";src:url('https://cdn.shopify.com/s/files/1/0559/0161/8328/files/Genera_Grotesk_Heavy.woff2?v=1732116436');font-weight:1000;font-style:normal;font-display:swap}

:root{
  --bg:#FFFFFF;
  --bg-soft:#F8F8F8;
  --ink:#0A0A0A;
  --gray:#6F6F6F;
  --line:#EAEAEA;
  --accent:#FF4E1B;
  --good:#0FA958;
  --display:'everett','Helvetica Neue',Arial,sans-serif;
  --body:'everett','Helvetica Neue',Arial,sans-serif;
  --mono:'everett','Helvetica Neue',Arial,sans-serif;
}
*{margin:0;padding:0;box-sizing:border-box;font-family:var(--body)}
html{scroll-behavior:smooth}
body{font-family:var(--body);background:var(--bg);color:var(--ink);overflow-x:hidden;-webkit-font-smoothing:antialiased}
::selection{background:var(--ink);color:#fff}
img{display:block;max-width:100%}
a{color:inherit;text-decoration:none}
button{font-family:inherit;cursor:pointer;border:none;background:none;color:inherit}

/* ============ TICKER ============ */
.ticker{
  background:var(--ink);color:#fff;overflow:hidden;white-space:nowrap;
  font-family:var(--mono);font-size:11.5px;font-weight:500;letter-spacing:.08em;
  padding:9px 0;position:relative;z-index:50;text-transform:uppercase;
}
.ticker__track{display:inline-flex;animation:tick 24s linear infinite}
.ticker__track span{padding:0 30px;display:inline-flex;align-items:center;gap:30px}
.ticker__track span::after{content:"✕";font-size:9px;color:var(--accent)}
@keyframes tick{to{transform:translateX(-50%)}}

/* ============ NAV ============ */
nav{
  position:sticky;top:0;z-index:100;display:flex;align-items:center;justify-content:space-between;
  padding:18px 28px;background:rgba(255,255,255,.92);backdrop-filter:blur(14px);
  border-bottom:1px solid var(--line);
}
.nav__logo img{height:28px;width:auto}
.nav__right{display:flex;align-items:center;gap:20px}
.nav__live{display:flex;align-items:center;gap:8px;color:var(--gray);font-size:12px;font-weight:400;text-transform:uppercase;letter-spacing:.04em}
.nav__live i{width:7px;height:7px;border-radius:50%;background:var(--good);animation:pulse 1.6s ease infinite}
@keyframes pulse{0%,100%{opacity:1;box-shadow:0 0 0 0 rgba(15,169,88,.4)}50%{opacity:.6;box-shadow:0 0 0 6px rgba(15,169,88,0)}}
.nav__cart{display:flex;align-items:center;color:var(--ink);transition:color .2s,transform .2s}
.nav__cart:hover{color:var(--accent);transform:scale(1.1)}

/* ============ BADGES ============ */
.badge{
  display:inline-block;font-size:11.5px;font-weight:500;letter-spacing:.1em;
  text-transform:uppercase;padding:7px 13px;
}
.badge--orange{background:var(--accent);color:#fff}
.badge--black{background:var(--ink);color:#fff}

/* ============ SCRIBBLE ============ */
.scribble{position:relative;display:inline-block;white-space:nowrap}
.scribble svg{
  position:absolute;left:-4%;bottom:-.3em;width:108%;height:.4em;overflow:visible;pointer-events:none;
}
.scribble svg path{
  fill:none;stroke:var(--ink);stroke-width:5;stroke-linecap:round;
  stroke-dasharray:240;stroke-dashoffset:240;
}
.in .scribble svg path:nth-child(1),.scribble.draw svg path:nth-child(1){animation:draw .55s .25s cubic-bezier(.6,0,.3,1) forwards}
.in .scribble svg path:nth-child(2),.scribble.draw svg path:nth-child(2){animation:draw .4s .6s cubic-bezier(.6,0,.3,1) forwards}
@keyframes draw{to{stroke-dashoffset:0}}
.u-doodle{
  display:inline-block;text-decoration:underline;
  text-underline-offset:6px;text-decoration-thickness:1.5px;
}
.u-doodle svg{display:none}

/* ============ HERO — split, clean, reactive ============ */
.hero{
  position:relative;display:grid;grid-template-columns:1fr 1.1fr;align-items:center;gap:30px;
  padding:54px 6vw 70px;min-height:78vh;overflow:hidden;background:#fff;
}
.hero::before{
  content:"WAVEY";position:absolute;right:-2vw;top:4px;z-index:0;
  font-family:var(--display);font-weight:700;font-size:clamp(110px,19vw,300px);
  letter-spacing:-.05em;line-height:1;color:transparent;-webkit-text-stroke:1px #ECECEC;
  pointer-events:none;user-select:none;
}
.hero__copy{position:relative;z-index:4}
.hero__salebadge{font-size:12.5px;letter-spacing:.12em;padding:10px 18px;transform:rotate(-1.5deg);display:inline-block;animation:rise .7s .05s both}
.hero h1{
  font-family:var(--display);font-weight:700;font-size:clamp(46px,6.4vw,96px);
  line-height:.96;letter-spacing:-.04em;margin:26px 0 0;animation:rise .7s .15s both;
}
.hero h1 em{font-style:normal;color:transparent;-webkit-text-stroke:1.5px var(--ink)}
.hero__sub{
  font-size:clamp(15.5px,1.3vw,18px);color:var(--gray);font-weight:300;
  margin:20px 0 0;max-width:400px;line-height:1.6;animation:rise .7s .25s both;
}
.hero__stars{display:flex;align-items:center;gap:9px;font-size:13px;color:var(--gray);margin:22px 0 0;animation:rise .7s .3s both}
.hero__stars b{color:var(--ink);letter-spacing:2px;font-weight:400}
/* color swatches in hero */
.hero__colors{display:flex;align-items:center;gap:12px;margin:30px 0 0;animation:rise .7s .4s both}
.swatch{
  position:relative;width:42px;height:42px;border-radius:50%;border:1px solid var(--line);
  display:grid;place-items:center;transition:transform .2s cubic-bezier(.2,1.6,.4,1),border-color .2s,box-shadow .2s;
}
.swatch i{width:30px;height:30px;border-radius:50%;border:1px solid rgba(0,0,0,.12)}
.swatch:hover{transform:scale(1.12);border-color:var(--ink)}
.swatch.active{border-color:var(--ink);box-shadow:2px 2px 0 var(--ink)}
.swatch.soldout{opacity:.5}
.swatch.soldout::after{
  content:"";position:absolute;width:48px;height:1.5px;background:var(--ink);transform:rotate(-45deg);
}
.hero__colorname{font-size:12.5px;font-weight:500;text-transform:uppercase;letter-spacing:.1em;margin-left:6px}
.hero__colorname s{color:#C4C4C4;font-weight:400}
.hero__ctas{display:flex;align-items:center;gap:22px;margin-top:32px;animation:rise .7s .5s both}
.btn-hero{
  display:inline-flex;align-items:center;gap:11px;background:var(--ink);color:#fff;
  font-weight:500;font-size:13.5px;text-transform:uppercase;letter-spacing:.08em;padding:18px 36px;
  position:relative;overflow:hidden;transition:transform .18s cubic-bezier(.2,1.6,.4,1),background .2s;
}
.btn-hero:hover{background:var(--accent);transform:translateY(-2px)}
.btn-hero:active{transform:scale(.97)}
.hero__shipnote{font-size:11.5px;font-weight:400;color:var(--gray);text-transform:uppercase;letter-spacing:.06em}

/* hero visual */
.hero__visual{position:relative;z-index:3;animation:rise .8s .2s both}
.hero__frame{
  position:relative;background:var(--bg-soft);aspect-ratio:4/4.5;overflow:hidden;
  will-change:transform;
}
.hero__frame img{
  width:100%;height:100%;object-fit:cover;transition:opacity .28s;will-change:transform;
}
.hero__chip{
  position:absolute;font-size:11.5px;font-weight:400;letter-spacing:.03em;z-index:5;
  background:#fff;border:1px solid var(--ink);color:var(--ink);
  padding:9px 14px;box-shadow:3px 3px 0 var(--ink);pointer-events:none;white-space:nowrap;
}
.hero__chip--1{top:7%;left:-14px}
.hero__chip--2{top:48%;right:-12px}
.hero__chip--3{bottom:8%;left:-10px;border-color:var(--accent);color:var(--accent);box-shadow:3px 3px 0 var(--accent)}
.hero__tag{
  position:absolute;top:14px;right:14px;z-index:6;transform:rotate(3deg);
  background:var(--ink);color:#fff;padding:11px 16px 10px;text-align:left;
  box-shadow:4px 4px 0 var(--accent);pointer-events:none;
}
.hero__tag b{display:block;font-family:var(--display);font-weight:700;font-size:21px;letter-spacing:-.02em;line-height:1}
.hero__tag span{display:block;font-size:9px;font-weight:500;letter-spacing:.18em;text-transform:uppercase;margin-top:5px;color:rgba(255,255,255,.75)}
@keyframes rise{from{opacity:0;transform:translateY(26px)}to{opacity:1;transform:none}}

/* ============ LOGO MARQUEE ============ */
.logos{
  overflow:hidden;white-space:nowrap;border-top:1px solid var(--line);border-bottom:1px solid var(--line);
  padding:20px 0;background:#fff;
}
.logos__track{display:inline-flex;align-items:center;gap:64px;animation:tick 32s linear infinite}
.logos__track span{flex:0 0 auto;color:var(--ink)}
.lv1{font-family:var(--display);font-weight:700;font-size:24px;letter-spacing:-.03em}
.lv2{font-family:'roc','Arial Black',sans-serif;font-weight:1000;font-size:24px;letter-spacing:-.01em;text-transform:uppercase}
.lv4{
  font-family:var(--display);font-weight:700;font-size:24px;letter-spacing:-.02em;
  color:transparent;-webkit-text-stroke:1px var(--ink);
}
.lv5{font-family:var(--display);font-weight:300;font-size:15px;letter-spacing:.42em;text-transform:uppercase}
.lv6{font-family:'roc','Arial Black',sans-serif;font-weight:1000;font-size:24px;color:var(--accent);text-transform:uppercase}

/* ============ SECTION BASE ============ */
section{padding:100px 5vw}
.kicker{
  font-size:12px;font-weight:500;letter-spacing:.22em;text-transform:uppercase;
  color:var(--accent);margin-bottom:18px;display:flex;align-items:center;gap:12px;
}
.kicker::before{content:"";width:34px;height:1px;background:var(--accent)}
h2{
  font-family:var(--display);font-weight:700;font-size:clamp(32px,4.4vw,60px);
  line-height:1.02;letter-spacing:-.03em;margin-bottom:16px;
}
.section-sub{color:var(--gray);font-size:16.5px;font-weight:300;max-width:520px;line-height:1.6}
.center{text-align:center}
.center .kicker{justify-content:center}
.center .kicker::before{display:none}
.center .section-sub{margin:0 auto}

/* ============ COMMUNITY RAIL (video) ============ */
.community{background:var(--bg);padding-top:60px}
.rail{
  display:flex;gap:18px;margin-top:50px;overflow-x:auto;padding:10px 4px 28px;
  scroll-snap-type:x mandatory;scrollbar-width:none;
}
.rail::-webkit-scrollbar{display:none}
.tcard{
  flex:0 0 min(285px,72vw);aspect-ratio:9/14;overflow:hidden;position:relative;
  scroll-snap-align:start;background:var(--bg-soft);
  transform:rotate(var(--rot,0deg));transition:transform .35s cubic-bezier(.2,1.4,.4,1);
  text-align:left;
}
.tcard:hover{transform:rotate(0) scale(1.03);z-index:3;box-shadow:0 24px 50px rgba(0,0,0,.18)}
.tcard img,.tcard video{width:100%;height:100%;object-fit:cover;transition:transform .6s}
.tcard:hover img{transform:scale(1.06)}
.tcard__overlay{
  position:absolute;inset:0;background:linear-gradient(180deg,rgba(10,10,10,.16),transparent 28%,transparent 56%,rgba(10,10,10,.82));
  display:flex;flex-direction:column;justify-content:space-between;padding:16px;color:#fff;pointer-events:none;
}
.tcard__views{
  align-self:flex-end;font-size:11.5px;font-weight:500;
  background:rgba(10,10,10,.6);backdrop-filter:blur(4px);padding:6px 11px;
  display:flex;align-items:center;gap:6px;
}
.tcard__cap{font-size:13.5px;font-weight:500;line-height:1.45}
.tcard__cap span{color:rgba(255,255,255,.7);font-weight:300;font-size:11px;display:block;margin-top:4px;text-transform:uppercase;letter-spacing:.04em}
.rail-hint{font-size:12px;font-weight:400;color:var(--gray);display:flex;align-items:center;justify-content:center;gap:10px;margin-top:4px;text-transform:uppercase;letter-spacing:.06em}
.rail-hint::after{content:"→";animation:nudge 1.4s ease infinite}
@keyframes nudge{0%,100%{transform:translateX(0)}50%{transform:translateX(7px)}}

/* ============ BUY ============ */
.buy{display:grid;grid-template-columns:1.05fr .95fr;gap:60px;align-items:start;background:var(--bg);border-top:1px solid var(--line)}
.buy__gallery{position:sticky;top:90px}
.buy__main{
  overflow:hidden;aspect-ratio:4/4.4;position:relative;background:var(--bg-soft);
}
.buy__main img{width:100%;height:100%;object-fit:cover;transition:opacity .3s}
.buy__main .badge{position:absolute;top:16px;left:16px;z-index:2;transform:rotate(-2deg)}
.buy__thumbs{display:grid;grid-template-columns:repeat(6,1fr);gap:8px;margin-top:8px}
.buy__thumbs button{
  aspect-ratio:1;overflow:hidden;border:1px solid transparent;
  opacity:.55;transition:.25s;padding:0;background:var(--bg-soft);position:relative;
}
.buy__thumbs button img{width:100%;height:100%;object-fit:cover}
.buy__thumbs button.active,.buy__thumbs button:hover{opacity:1;border-color:var(--ink)}
.buy__thumbs button i{
  position:absolute;bottom:4px;left:4px;width:9px;height:9px;border-radius:50%;
  border:1px solid rgba(0,0,0,.2);
}
.buy__thumbs button i.grey{background:#B9B7B2}
.buy__thumbs button i.beige{background:#D8C9B4}
.buy__thumbs button i.army{background:#6B7256}
.buy__thumbs button i.pink{background:#E3B7BD}

.details{margin-top:30px}
.details h3{font-family:var(--display);font-weight:700;font-size:19px;letter-spacing:-.02em;margin-bottom:18px}
.details__grid{display:grid;grid-template-columns:1fr 1fr;gap:16px 20px}
.details__grid div{display:flex;align-items:center;gap:12px;font-size:14px;font-weight:400}
.details__grid svg{width:20px;height:20px;stroke:var(--ink);flex:0 0 auto}

.buy__panel h2{font-size:clamp(30px,3.4vw,48px)}
.buy__rating{display:flex;align-items:center;gap:10px;font-size:13px;font-weight:400;margin:8px 0 22px;color:var(--gray)}
.buy__rating b{color:var(--ink);letter-spacing:2px;font-weight:400}
.buy__price{display:flex;align-items:baseline;gap:14px;margin-bottom:26px}
.buy__price .now{font-family:var(--display);font-weight:700;font-size:38px;letter-spacing:-.03em}
.buy__price .was{color:var(--gray);text-decoration:line-through;font-size:16px;font-weight:300}
.buy__price .off{font-size:11.5px;font-weight:500;background:var(--accent);color:#fff;padding:4px 10px;text-transform:uppercase;letter-spacing:.06em}

.opt-label{
  font-size:12px;font-weight:500;letter-spacing:.14em;text-transform:uppercase;
  color:var(--gray);margin:24px 0 12px;display:flex;justify-content:space-between;
}
.opt-label output{color:var(--ink)}
.colors{display:flex;gap:10px;flex-wrap:wrap}
.color-btn{
  display:flex;align-items:center;gap:10px;padding:12px 18px;
  border:1px solid var(--line);font-size:13.5px;font-weight:400;transition:.2s;background:#fff;
}
.color-btn i{width:17px;height:17px;border-radius:50%;border:1px solid rgba(0,0,0,.15)}
.color-btn[data-color="grey"] i{background:linear-gradient(135deg,#C6C4BF,#9D9B95)}
.color-btn[data-color="beige"] i{background:linear-gradient(135deg,#E2D5C0,#C5B295)}
.color-btn[data-color="army"] i{background:linear-gradient(135deg,#7C835F,#565D40)}
.color-btn[data-color="pink"] i{background:linear-gradient(135deg,#EFC7CD,#D9A3AC)}
.color-btn.active{border-color:var(--ink);box-shadow:2px 2px 0 var(--ink)}
.color-btn:hover{border-color:var(--ink)}
.color-btn.soldout{color:#9b9b9b;background:var(--bg-soft)}
.color-btn.soldout s{margin-right:2px}
.color-btn.soldout i{opacity:.5}
.color-btn.soldout.active{border-color:var(--ink);box-shadow:2px 2px 0 var(--ink);color:var(--ink)}
.atc.soldout{background:#BDBDBD;pointer-events:none}
.atc.soldout::after{display:none}
.size-btn.soldout{
  color:#C4C4C4;background:var(--bg-soft);cursor:not-allowed;text-decoration:line-through;
}
.size-btn.soldout:hover{border-color:var(--line)}
.sizes{display:grid;grid-template-columns:repeat(5,1fr);gap:8px}
.size-btn{
  padding:13px 0;border:1px solid var(--line);background:#fff;
  font-size:13.5px;font-weight:400;transition:.18s;position:relative;
}
.size-btn:hover{border-color:var(--ink)}
.size-btn.active{background:var(--ink);color:#fff;border-color:var(--ink)}
.size-btn.low::after{
  content:"";position:absolute;top:5px;right:5px;width:6px;height:6px;border-radius:50%;
  background:var(--accent);animation:pulse 1.6s infinite;
}
.sizes.flash{animation:sizeflash .55s ease 2}
@keyframes sizeflash{0%,100%{box-shadow:0 0 0 0 transparent}50%{box-shadow:0 0 0 3px var(--accent)}}
.size-note{font-size:11.5px;font-weight:400;color:var(--gray);margin-top:10px;text-transform:uppercase;letter-spacing:.03em}
.size-note b{color:var(--accent);font-weight:500}

/* ---- scarcity ---- */
.scarcity{margin-top:28px;border:1px solid var(--ink);padding:20px 22px;background:#fff}
.scarcity__row{display:flex;justify-content:space-between;align-items:baseline;font-size:12.5px;font-weight:500;text-transform:uppercase;letter-spacing:.05em}
.scarcity__row b{color:var(--accent);font-weight:500}
.scarcity__bar{height:7px;background:var(--bg-soft);margin:12px 0 18px;overflow:hidden}
.scarcity__fill{
  height:100%;background:var(--accent);width:35%;transition:width 1s ease;
  background-image:linear-gradient(90deg,rgba(255,255,255,.25) 25%,transparent 25%,transparent 50%,rgba(255,255,255,.25) 50%,rgba(255,255,255,.25) 75%,transparent 75%);
  background-size:14px 100%;animation:barber 1.2s linear infinite;
}
@keyframes barber{to{background-position:14px 0}}
.scarcity__label{font-size:11.5px;font-weight:500;color:var(--gray);text-transform:uppercase;letter-spacing:.08em}
.scarcity__time{
  position:relative;display:inline-block;font-family:var(--display);font-weight:700;
  font-size:clamp(34px,3.4vw,46px);letter-spacing:-.02em;line-height:1.1;margin-top:4px;
  font-variant-numeric:tabular-nums;
}
.scarcity__time svg{position:absolute;left:0;bottom:-8px;width:100%;height:9px;overflow:visible}
.scarcity__time svg path{fill:none;stroke:var(--accent);stroke-width:4;stroke-linecap:round}
.scarcity__after{font-size:11.5px;font-weight:400;color:var(--gray);margin-top:16px;text-transform:uppercase;letter-spacing:.04em}

/* ---- ship line + ATC + USPs ---- */
.shipline{
  display:flex;align-items:center;justify-content:flex-end;gap:8px;
  font-size:13px;font-weight:400;margin:20px 0 10px;
}
.shipline i{width:8px;height:8px;border-radius:50%;background:var(--ink);flex:0 0 auto}
.shipline b{font-weight:500}
.atc{
  width:100%;background:var(--accent);color:#fff;font-weight:500;
  font-size:16px;text-transform:none;letter-spacing:0;padding:21px;
  display:flex;align-items:center;justify-content:center;gap:12px;position:relative;overflow:hidden;
  transition:transform .18s cubic-bezier(.2,1.6,.4,1),background .2s;
}
.atc:hover{background:var(--ink);transform:translateY(-2px)}
.atc:active{transform:scale(.98)}
.atc::after{
  content:"";position:absolute;inset:0;background:linear-gradient(115deg,transparent 35%,rgba(255,255,255,.25) 50%,transparent 65%);
  transform:translateX(-110%);animation:shine 3.8s 2s ease infinite;
}
@keyframes shine{0%{transform:translateX(-110%)}45%,100%{transform:translateX(110%)}}
.usps{display:flex;justify-content:center;gap:38px;margin-top:22px;flex-wrap:wrap}
.usps div{display:flex;align-items:center;gap:10px;font-size:13.5px;font-weight:400}
.usps svg{width:18px;height:18px;stroke:var(--ink);flex:0 0 auto}

/* ---- trust row ---- */
.trust-row{
  display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-top:26px;padding-top:24px;
  border-top:1px solid var(--line);
}
.trust-row>div{display:flex;flex-direction:column;align-items:center;gap:9px;text-align:center}
.trust-row svg{width:21px;height:21px;stroke:var(--ink)}
.trust-row span{font-size:10.5px;font-weight:400;color:var(--gray);line-height:1.5;text-transform:uppercase;letter-spacing:.04em}

/* ============ LOOKBOOK ============ */
.lookbook{background:var(--bg-soft)}
.tcard__label{
  position:absolute;left:14px;bottom:12px;font-size:11px;font-weight:500;letter-spacing:.08em;
  text-transform:uppercase;color:#fff;background:rgba(10,10,10,.7);padding:7px 12px;backdrop-filter:blur(4px);
}

/* ============ SPECS ============ */
.specs{background:#fff;border-top:1px solid var(--line)}
.specs__inner{display:grid;grid-template-columns:1fr 1.05fr;gap:70px;align-items:center;max-width:1280px;margin:0 auto}
.specs__visual{
  position:relative;aspect-ratio:4/4.6;overflow:hidden;background:var(--bg-soft);
  transform-style:preserve-3d;will-change:transform;
}
.specs__visual img{width:104%;height:104%;object-fit:cover;will-change:transform}
.specs__shine{
  position:absolute;inset:0;pointer-events:none;
  background:linear-gradient(115deg,transparent 30%,rgba(255,255,255,.28) 50%,transparent 70%);
  background-size:250% 100%;background-position:var(--shx,80%) 0;
}
.specs__tag{position:absolute;top:16px;left:16px;transform:rotate(-2deg)}
.sline{
  display:grid;grid-template-columns:54px 1fr;gap:18px;padding:24px 0;
  border-top:1px solid var(--line);transition:.25s;cursor:default;
}
.sline:last-child{border-bottom:1px solid var(--line)}
.sline:hover{padding-left:10px}
.sline em{font-style:normal;font-size:12.5px;font-weight:500;color:#BBB;transition:.25s;letter-spacing:.06em;padding-top:3px}
.sline:hover em{color:var(--accent)}
.sline h3{font-family:var(--display);font-weight:500;font-size:18px;letter-spacing:-.01em;margin-bottom:6px}
.sline p{font-size:14px;line-height:1.6;color:var(--gray);font-weight:300}
.specs__list .section-sub{margin-bottom:38px}

/* ============ PHOTO REVIEWS ============ */
.reviews{background:var(--bg-soft)}
.reviews__head{display:flex;justify-content:space-between;align-items:flex-end;flex-wrap:wrap;gap:20px}
.reviews__score{text-align:right}
.reviews__score .big{font-family:var(--display);font-weight:700;font-size:62px;line-height:1;letter-spacing:-.03em}
.reviews__score .stars{letter-spacing:3px;font-size:15px}
.reviews__score .count{font-size:12px;font-weight:400;color:var(--gray);margin-top:6px;text-transform:uppercase;letter-spacing:.04em}
.reviews__grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:50px}
.review{background:#fff;transition:.25s;position:relative;overflow:hidden;text-align:left}
.review:hover{transform:translateY(-4px);box-shadow:0 16px 40px rgba(0,0,0,.08)}
.review__photo{aspect-ratio:4/4.2;overflow:hidden;background:var(--bg-soft)}
.review__photo img{width:100%;height:100%;object-fit:cover;transition:transform .6s}
.review:hover .review__photo img{transform:scale(1.05)}
.review__body{padding:24px 24px 26px}
.review .stars{letter-spacing:2.5px;font-size:12.5px;margin-bottom:13px}
.review p{font-size:14px;line-height:1.65;color:#3c3c3c;font-weight:300;margin-bottom:18px}
.review__who{display:flex;align-items:center;gap:11px;font-size:12px;font-weight:400}
.review__avatar{
  width:36px;height:36px;border-radius:50%;display:grid;place-items:center;
  background:var(--bg-soft);color:var(--ink);font-size:12px;font-weight:500;flex:0 0 auto;
}
.review__who .v{color:var(--good);font-size:11px;display:flex;align-items:center;gap:4px;margin-top:3px}

/* ============ FINAL ============ */
.final{background:#fff;border-top:1px solid var(--line);text-align:center;padding:120px 5vw}
.final .kicker{justify-content:center}
.final .kicker::before{display:none}
.final h2{font-size:clamp(40px,5.6vw,76px)}
.final p{font-size:17px;color:var(--gray);font-weight:300;margin:18px auto 38px;max-width:400px}
.btn-main{
  display:inline-flex;align-items:center;gap:12px;background:var(--ink);color:#fff;
  font-weight:500;font-size:14px;text-transform:uppercase;letter-spacing:.08em;
  padding:20px 46px;position:relative;overflow:hidden;
  transition:transform .18s cubic-bezier(.2,1.6,.4,1),background .2s;
}
.btn-main:hover{background:var(--accent);transform:translateY(-2px)}
.btn-main:active{transform:scale(.97)}
.final__note{margin-top:22px;font-size:11.5px;font-weight:400;color:#9b9b9b;text-transform:uppercase;letter-spacing:.06em}

/* ============ BRAND FOOT ============ */
.brandfoot{
  border-top:1px solid var(--line);text-align:center;padding:90px 5vw 70px;background:#fff;
}
.brandfoot .kicker{justify-content:center;margin-bottom:24px}
.brandfoot .kicker::before{display:none}
.brandfoot__logo{width:min(760px,90vw);height:auto;margin:0 auto 26px}
.brandfoot__story{max-width:560px;margin:0 auto 30px;font-size:15px;font-weight:300;line-height:1.7;color:var(--gray)}
.brandfoot__story b{color:var(--ink);font-weight:500}
.brandfoot__stars{font-size:24px;letter-spacing:8px;color:var(--ink)}
.brandfoot__text{
  margin-top:12px;font-size:14px;font-weight:500;letter-spacing:.14em;
  text-transform:uppercase;color:var(--gray);
}
.brandfoot__text b{color:var(--ink);font-weight:700}

footer{
  border-top:1px solid var(--line);padding:40px 5vw;background:var(--ink);color:#fff;
  display:flex;flex-direction:column;align-items:center;gap:24px;text-align:center;
}
.footer__brand{display:flex;flex-direction:column;align-items:center;gap:12px}
.footer__brand img{height:22px;width:auto}
.footer__brand p{font-size:11.5px;font-weight:400;color:rgba(255,255,255,.55);text-transform:uppercase;letter-spacing:.1em}
.footer__nav{display:flex;flex-wrap:wrap;justify-content:center;gap:10px 26px;
  position:static;background:transparent;backdrop-filter:none;border:none;padding:0}
.footer__nav a{font-size:12.5px;font-weight:400;color:rgba(255,255,255,.85);transition:color .2s;position:relative}
.footer__nav a:hover{color:#fff}
.footer__nav a::after{content:"";position:absolute;left:0;right:0;bottom:-4px;height:1px;background:var(--accent);transform:scaleX(0);transition:transform .25s}
.footer__nav a:hover::after{transform:scaleX(1)}
.footer__legal{display:flex;flex-wrap:wrap;justify-content:center;gap:6px 22px;padding-top:18px;border-top:1px solid rgba(255,255,255,.12);width:100%;max-width:760px}
.footer__legal span{font-size:10.5px;font-weight:400;color:rgba(255,255,255,.4);text-transform:uppercase;letter-spacing:.06em}

/* ============ STICKY BAR ============ */
.sticky-bar{
  position:fixed;left:0;right:0;bottom:0;z-index:200;display:flex;align-items:center;gap:14px;
  background:rgba(255,255,255,.94);backdrop-filter:blur(16px);border-top:1.5px solid var(--ink);
  padding:12px 18px;transform:translateY(110%);transition:transform .4s cubic-bezier(.2,1,.3,1);
}
.sticky-bar.show{transform:none}
.sticky-bar img{width:48px;height:48px;object-fit:cover;background:var(--bg-soft)}
.sticky-bar__info{flex:1;min-width:0}
.sticky-bar__info b{display:block;font-size:13.5px;font-weight:500;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.sticky-bar__info span{font-size:11.5px;font-weight:400;color:var(--gray)}
.sticky-bar__price{font-family:var(--display);font-weight:700;font-size:19px;letter-spacing:-.02em}
.sticky-bar__price s{font-size:10.5px;color:var(--gray);display:block;font-weight:400}
.sticky-bar .btn-bar{
  background:var(--accent);color:#fff;font-weight:500;font-size:13px;
  padding:14px 26px;transition:background .2s;
}
.sticky-bar .btn-bar:hover{background:var(--ink)}

/* ============ TOAST ============ */
.toast{
  position:fixed;left:18px;bottom:90px;z-index:300;display:flex;align-items:center;gap:13px;
  background:#fff;color:var(--ink);padding:13px 18px 13px 13px;border:1px solid var(--ink);
  box-shadow:5px 5px 0 var(--ink);max-width:330px;
  transform:translateX(-130%);transition:transform .5s cubic-bezier(.2,1.2,.3,1);
}
.toast.show{transform:none}
.toast img{width:46px;height:46px;object-fit:cover;background:var(--bg-soft)}
.toast b{font-size:13px;font-weight:500;display:block}
.toast span{font-size:11px;font-weight:400;color:var(--gray)}

/* ============ REVEAL ============ */
.reveal{opacity:0;transform:translateY(34px);transition:opacity .7s ease,transform .7s cubic-bezier(.2,.8,.3,1)}
.reveal.in{opacity:1;transform:none}
.reveal:nth-child(2){transition-delay:.08s}.reveal:nth-child(3){transition-delay:.16s}
.reveal:nth-child(4){transition-delay:.24s}.reveal:nth-child(5){transition-delay:.32s}
.reveal:nth-child(6){transition-delay:.4s}

/* ============ SCRATCH POPUP ============ */
.sc-modal{
  position:fixed;inset:0;z-index:500;display:flex;align-items:center;justify-content:center;padding:20px;
  background:rgba(10,10,10,.62);backdrop-filter:blur(6px);
  opacity:0;visibility:hidden;transition:opacity .35s ease,visibility .35s;
}
.sc-modal.open{opacity:1;visibility:visible}
.sc-modal__box{
  position:relative;width:min(440px,94vw);background:#fff;padding:38px 28px 26px;text-align:center;
  box-shadow:0 30px 80px rgba(0,0,0,.4);transform:translateY(24px) scale(.96);transition:transform .4s cubic-bezier(.2,1.3,.3,1);
  display:flex;flex-direction:column;align-items:center;gap:0;
}
.sc-modal.open .sc-modal__box{transform:none}
.sc-modal__x{
  position:absolute;top:12px;right:14px;width:32px;height:32px;font-size:15px;color:var(--gray);
  display:grid;place-items:center;transition:color .2s,transform .2s;
}
.sc-modal__x:hover{color:var(--ink);transform:scale(1.15)}
.sc-modal__head h3{font-family:var(--display);font-weight:700;font-size:30px;letter-spacing:-.03em;line-height:1}
.sc-modal__head p{font-size:14px;color:var(--gray);font-weight:300;margin:10px 0 22px}
.scratch-card{
  position:relative;width:min(360px,86vw);aspect-ratio:8/5;border-radius:18px;overflow:hidden;
  box-shadow:0 16px 40px rgba(0,0,0,.18);transition:transform .5s cubic-bezier(.2,1.4,.3,1);
}
.scratch-card.win{transform:scale(1.04)}
.scratch-prize{
  position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;
  background:radial-gradient(circle at 50% 35%,#fff,#F1F1F1);text-align:center;padding:20px;
}
.scratch-tag{font-size:10.5px;font-weight:500;letter-spacing:.14em;text-transform:uppercase;color:#fff;background:var(--ink);padding:5px 11px;margin-bottom:4px}
.scratch-off{font-family:var(--display);font-weight:700;font-size:clamp(44px,12vw,64px);letter-spacing:-.03em;color:var(--accent);line-height:.9}
.scratch-price{font-family:var(--display);font-weight:700;font-size:26px;letter-spacing:-.02em}
.scratch-price s{font-size:15px;color:var(--gray);font-weight:400;margin-left:6px}
.scratch-sub{font-size:11.5px;font-weight:500;text-transform:uppercase;letter-spacing:.12em;color:var(--gray)}
.scratch-foil{position:absolute;inset:0;width:100%;height:100%;cursor:grab;touch-action:none;transition:opacity .5s}
.scratch-foil.gone{opacity:0;pointer-events:none}
.scratch-claim{
  margin-top:22px;background:var(--accent);color:#fff;font-weight:500;font-size:15px;letter-spacing:.04em;
  padding:17px 38px;text-transform:uppercase;box-shadow:0 12px 30px rgba(255,78,27,.32);
  max-height:0;opacity:0;overflow:hidden;transform:translateY(8px);
  transition:opacity .45s .15s,transform .45s .15s,max-height .45s,background .2s,padding .3s;
}
.scratch-claim.show{max-height:80px;opacity:1;transform:none}
.scratch-claim:hover{background:var(--ink)}
.scratch-foot{font-size:11px;font-weight:400;color:var(--gray);text-transform:uppercase;letter-spacing:.06em;margin-top:14px}
/* confetti */
.confetti{position:fixed;inset:0;pointer-events:none;z-index:400;overflow:hidden}
.confetti i{position:absolute;top:-12px;width:9px;height:14px;opacity:.95;animation:confFall linear forwards}
@keyframes confFall{to{transform:translateY(110vh) rotate(720deg);opacity:.9}}

/* ============ RESPONSIVE ============ */
@media (max-width:980px){
  .hero{grid-template-columns:1fr;min-height:0;padding:34px 6vw 60px;gap:36px}
