/* ---- 10-minuten discount-timer: start zodra de korting gewonnen is ---- */
var cdTimer = null;
var WIN_MS = 10 * 60 * 1000;
function winRemaining() {
  var ts = +localStorage.getItem('ngc_win_ts') || 0;
  if (!ts) return WIN_MS;
  return Math.max(0, WIN_MS - (Date.now() - ts));
}
function startWinCountdown() {
  var cdEl = document.getElementById('cd');
  function tick() {
    var d = winRemaining();
    var m = String(Math.floor(d / 6e4)).padStart(2, '0');
    var s = String(Math.floor(d % 6e4 / 1e3)).padStart(2, '0');
    cdEl.textContent = m + ':' + s;
    if (d <= 0) document.getElementById('cdAfter').textContent = 'Last chance — checkout now';
  }
  tick(); if (cdTimer) clearInterval(cdTimer); cdTimer = setInterval(tick, 1000);
}

