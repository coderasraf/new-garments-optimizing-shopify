<script>
const CDN = 'https://cdn.shopify.com/s/files/1/0948/8973/8617/files/';
const STORE = 'https://newgarments.store/products/';

/* 6 longsleeves — handle, prices, colorways (real product images) */
const PRODUCTS = [
  { name:'Vertical Signature', handle:'vertical-signature-longsleeve-midnight-black', price:'€45,95', was:'€93,95', save:'€48', tag:'Best seller', colors:[
    {n:'Black', dot:'#1D1D1F', img:CDN+'1_f17cfad4-df56-417d-9d1b-b15bd3f51fc0.png?v=1768226313'},
    {n:'Pearl White', dot:'#ECECE9', img:CDN+'4_6c9dbecb-11d9-4427-b930-1bf547b7434f.png?v=1768226313'},
    {n:'Ash Pink', dot:'#EFCBD4', img:CDN+'7_288b06e8-9ba0-426e-8e09-50887fbbf7cf.png?v=1768226313'},
    {n:'Moss Green', dot:'#9AA886', img:CDN+'9_3de30956-6d2b-4c58-a5ad-f4f2d77e966b.png?v=1768226313'} ]},
  { name:'Chrome Identity', handle:'chrome-identity-longsleeve-pearl-white', price:'€49,95', was:'€99,95', save:'€50', tag:null, colors:[
    {n:'Pearl White', dot:'#ECECE9', img:CDN+'2_0bc41f07-bd1b-40fc-9b9d-c4328f481c2b.png?v=1768230216'},
    {n:'Black', dot:'#1D1D1F', img:CDN+'5_4230e782-b59e-4088-a0ef-364b369f54cc.png?v=1768225540'},
    {n:'Ash Pink', dot:'#EFCBD4', img:CDN+'10_a4dda0a3-d603-4b5b-9b98-7823fd50289b.png?v=1768225540'},
    {n:'Moss Green', dot:'#9AA886', img:CDN+'8_db718bc4-6dc5-4d79-bcd4-33a22e02d21d.png?v=1768230216'} ]},
  { name:'Equestrian', handle:'equestrian-longsleeve-pearl-white-1', price:'€39,95', was:'€74,95', save:'€35', tag:'Almost gone', colors:[
    {n:'Pearl White', dot:'#ECECE9', img:CDN+'bg_swap_0.jpg?v=1778748042'} ]},
  { name:'Cherry', handle:'newgarments-cherry-longsleeve-pearl-white', price:'€49,95', was:'€99,95', save:'€50', tag:null, colors:[
    {n:'Pearl White', dot:'#ECECE9', img:CDN+'5_74af259c-de34-4968-89a6-251c5e4528c1.png?v=1768228332'},
    {n:'Black', dot:'#1D1D1F', img:CDN+'2_0d6de1fe-d60e-401e-8159-dc53ff434756.png?v=1768228332'} ]},
  { name:'Worldwide Mark', handle:'worldwide-mark-longsleeve-pearl-white', price:'€49,95', was:'€99,95', save:'€50', tag:null, colors:[
    {n:'Pearl White', dot:'#ECECE9', img:CDN+'3_feb2c387-c794-40f2-98b3-004a307f57fb.png?v=1768226861'},
    {n:'Black', dot:'#1D1D1F', img:CDN+'14_26f6484b-fc5e-4062-8f32-fe9d0bf79b94.png?v=1768226861'} ]},
  { name:'Fragmented Rosé', handle:'fragmented-rose-longsleeve-midnight-black', price:'€45,95', was:'€93,95', save:'€48', tag:null, colors:[
    {n:'Rose Gold', dot:'#DBB6BD', img:CDN+'3_a6c8eee1-f727-42e2-81ce-b94084518d2c.png?v=1768223835'},
    {n:'Royal Blue', dot:'#5B79B8', img:CDN+'1_05422d78-9320-44d7-acb4-b8eb41dfb49f.png?v=1768223835'} ]}
];

let unlocked = localStorage.getItem('ngl_unlocked') === '1';
if (unlocked) document.body.classList.add('unlocked');

/* ---- build the grid ---- */
const grid = document.getElementById('grid');
PRODUCTS.forEach((p, pi) => {
  const card = document.createElement('div');
  card.className = 'pcard reveal';
  const dots = p.colors.length > 1 ? '<div class="pdots">' + p.colors.map((col, ci) =>
    `<button style="background:${col.dot}" data-p="${pi}" data-c="${ci}" class="${ci===0?'on':''}" aria-label="${col.n}"></button>`).join('') + '</div>' : '';
  card.innerHTML =
    `<a class="pcard__img" href="${STORE}${p.handle}" data-shop="${pi}">` +
      (p.tag ? `<span class="pcard__tag${p.tag==='Almost gone'?' alt':''}">${p.tag}</span>` : '') +
      `<img id="limg${pi}" src="${p.colors[0].img}&width=720" alt="${p.name} longsleeve" loading="lazy">` +
      `<span class="pcard__shop">Shop ${p.name} →</span>` +
    `</a>` +
    `<div class="pcard__meta"><div><h3>${p.name}</h3><div class="cn" id="lcn${pi}">${p.colors[0].n}</div></div>` +
      `<div class="pcard__price"><span class="lnow">${p.was}</span>` +
        `<s class="lwas" style="display:none">${p.was}</s>` +
        `<span class="save">Save ${p.save}</span></div></div>` +
    dots;
  grid.appendChild(card);
});

/* apply price state to every card */
function applyPriceState() {
  PRODUCTS.forEach((p, pi) => {
    const card = grid.children[pi];
    const now = card.querySelector('.lnow');
    const was = card.querySelector('.lwas');
    if (unlocked) {
      now.textContent = p.price; was.style.display = 'block';
      document.body.classList.add('unlocked');
    } else {
      now.textContent = p.was; was.style.display = 'none';
    }
  });
  const heroFrom = document.getElementById('heroFrom'), heroFromSub = document.getElementById('heroFromSub');
  const heroBadge = document.getElementById('heroSaleBadge');
  const tkDeals = document.querySelectorAll('.tk-deal');
  if (unlocked) {
    heroFrom.textContent = 'From €39,95'; heroFromSub.innerHTML = '<s style="color:#9b9b9b">€74,95</s> drop price';
    heroBadge.textContent = 'You unlocked the drop prices';
    tkDeals.forEach(s => s.textContent = 'Drop prices unlocked — up to 50% off');
  } else {
    heroFrom.textContent = 'From €74,95'; heroFromSub.textContent = 'heavyweight cotton';
    heroBadge.textContent = 'The drop — no restock';
    tkDeals.forEach(s => s.textContent = 'Ships out in 1–2 days');
  }
}

/* ---- color dot swap ---- */
grid.addEventListener('click', e => {
  const b = e.target.closest('.pdots button');
  if (!b) return;
  const p = PRODUCTS[+b.dataset.p], col = p.colors[+b.dataset.c];
  const img = document.getElementById('limg' + b.dataset.p);
  img.style.opacity = 0;
  setTimeout(() => { img.src = col.img + '&width=720'; img.style.opacity = 1; }, 180);
  document.getElementById('lcn' + b.dataset.p).textContent = col.n;
  b.parentNode.querySelectorAll('button').forEach(x => x.classList.remove('on'));
  b.classList.add('on');
});

/* ---- shop click guard: scratch first if locked ---- */
grid.addEventListener('click', e => {
  const a = e.target.closest('.pcard__img');
  if (!a) return;
  if (!unlocked) { e.preventDefault(); openScratch(); }
});

/* ---- confetti ---- */
function confetti() {
  const wrap = document.createElement('div'); wrap.className = 'confetti';
  const colors = ['#FF4E1B', '#0A0A0A', '#EFCBD4', '#9AA886', '#5B79B8'];
  for (let i = 0; i < 90; i++) {
    const c = document.createElement('i');
    c.style.left = (5 + i / 90 * 90) + '%';
    c.style.background = colors[i % colors.length];
    c.style.animationDuration = (1.6 + (i % 7) * 0.18) + 's';
    c.style.animationDelay = ((i % 11) * 0.04) + 's';
    c.style.transform = 'rotate(' + (i * 37 % 360) + 'deg)';
    wrap.appendChild(c);
  }
  document.body.appendChild(wrap);
  setTimeout(() => wrap.remove(), 4200);
}

/* ---- scratch card ---- */
const scModal = document.getElementById('scModal');
const scCard = document.getElementById('scratchCard');
const canvas = document.getElementById('scratchCanvas');
const scClaim = document.getElementById('scratchClaim');
const scClose = document.getElementById('scClose');
const scSub = document.getElementById('scSub');
let scratching = false, revealed = unlocked, lastP = 0, painted = false;
function paintFoil() {
  const ctx = canvas.getContext('2d');
  const r = scCard.getBoundingClientRect();
  if (r.width < 2) return;
  const dpr = Math.min(window.devicePixelRatio || 1, 2);
  canvas.width = r.width * dpr; canvas.height = r.height * dpr;
  ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  ctx.globalCompositeOperation = 'source-over';
  const g = ctx.createLinearGradient(0, 0, r.width, r.height);
  g.addColorStop(0, '#E6B73E'); g.addColorStop(.42, '#F7E596'); g.addColorStop(.55, '#EFD06A'); g.addColorStop(1, '#C9971F');
  ctx.fillStyle = g; ctx.fillRect(0, 0, r.width, r.height);
  ctx.fillStyle = 'rgba(255,255,255,.16)';
  for (let i = -r.height; i < r.width; i += 22) { ctx.save(); ctx.translate(i, 0); ctx.rotate(.3); ctx.fillRect(0, -r.height, 8, r.height * 3); ctx.restore(); }
  ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
  ctx.fillStyle = 'rgba(150,110,20,.30)';
  ctx.font = '800 ' + Math.round(r.height * .72) + 'px roc, "Arial Black", sans-serif';
  ctx.save(); ctx.translate(r.width / 2, r.height / 2); ctx.rotate(-.12); ctx.fillText('WIN', 0, 0); ctx.restore();
  ctx.fillStyle = 'rgba(255,255,255,.9)';
  ctx.font = '700 ' + Math.round(r.width * .085) + 'px everett, Arial';
  ctx.fillText('SCRATCH HERE', r.width / 2, r.height / 2);
  painted = true;
}
function ptr(e) { const r = canvas.getBoundingClientRect(); return { x: e.clientX - r.left, y: e.clientY - r.top }; }
function scratch(e) {
  if (!scratching || revealed) return;
  const ctx = canvas.getContext('2d'); const p = ptr(e);
  ctx.globalCompositeOperation = 'destination-out';
  ctx.beginPath(); ctx.arc(p.x, p.y, 28, 0, Math.PI * 2); ctx.fill();
  if (performance.now() - lastP > 160) { lastP = performance.now(); checkCleared(); }
}
function checkCleared() {
  const ctx = canvas.getContext('2d');
  const img = ctx.getImageData(0, 0, canvas.width, canvas.height).data;
  let clear = 0; for (let i = 3; i < img.length; i += 40) { if (img[i] === 0) clear++; }
  if (clear / (img.length / 40) > 0.45) reveal();
}
function reveal() {
  if (revealed) return; revealed = true; unlocked = true;
  localStorage.setItem('ngl_unlocked', '1');
  if (!localStorage.getItem('ngl_win_ts')) localStorage.setItem('ngl_win_ts', Date.now());
  canvas.classList.add('gone'); scCard.classList.add('win');
  scSub.textContent = 'Unlocked — drop prices on the whole edit, locked for 10 min 🔥';
  scClaim.hidden = false; requestAnimationFrame(() => scClaim.classList.add('show'));
  confetti(); applyPriceState();
}
function openScratch() {
  if (unlocked || scModal.classList.contains('open')) return;
  scModal.classList.add('open'); scModal.setAttribute('aria-hidden', 'false');
  document.body.style.overflow = 'hidden';
  if (!revealed && !painted) setTimeout(paintFoil, 50);
}
function closeScratch() {
  scModal.classList.remove('open'); scModal.setAttribute('aria-hidden', 'true');
  document.body.style.overflow = '';
}
if (canvas) {
  canvas.addEventListener('pointerdown', e => { scratching = true; try { canvas.setPointerCapture(e.pointerId); } catch (_) {} scratch(e); });
  canvas.addEventListener('pointermove', scratch);
  ['pointerup', 'pointercancel'].forEach(ev => canvas.addEventListener(ev, () => { scratching = false; }));
  scClose.addEventListener('click', closeScratch);
  scModal.addEventListener('click', e => { if (e.target === scModal) closeScratch(); });
  scClaim.addEventListener('click', () => { closeScratch(); document.getElementById('edit').scrollIntoView({ behavior: 'smooth' }); });
  if (revealed) { canvas.classList.add('gone'); scClaim.hidden = false; scClaim.classList.add('show'); scCard.classList.add('win'); scSub.textContent = 'Drop prices unlocked 🔥'; }
}
/* trigger: open popup once the visitor reaches the edit grid */
if (!unlocked) {
  let popped = false;
  new IntersectionObserver(ents => {
    if (ents[0].isIntersecting && !popped && !unlocked) { popped = true; openScratch(); }
  }, { threshold: 0.2 }).observe(document.getElementById('edit'));
}

applyPriceState();

/* ---- 10-minute timer in ticker once won (subtle) ---- */
var WIN_MS = 10 * 60 * 1000;
function winRemaining() {
  var ts = +localStorage.getItem('ngl_win_ts') || 0;
  if (!ts) return WIN_MS;
  return Math.max(0, WIN_MS - (Date.now() - ts));
}
var cdTimer = null;
if (unlocked) {
  cdTimer = setInterval(function () {
    var d = winRemaining();
    var m = String(Math.floor(d / 6e4)).padStart(2, '0');
    var s = String(Math.floor(d % 6e4 / 1e3)).padStart(2, '0');
    document.querySelectorAll('.tk-deal').forEach(function (x) { x.textContent = 'Drop prices unlocked — ' + m + ':' + s + ' left'; });
  }, 1000);
}

/* ---- live viewers ---- */
const liveEl = document.getElementById('liveCount');
setInterval(() => { liveEl.textContent = 42 + Math.floor(Math.random() * 30); }, 6000);

/* ---- purchase toasts ---- */
const BUYERS = [
  ['Maléna from Paris', 0, 'Pearl White'], ['Thiago from Lisbon', 5, 'Royal Blue'],
  ['Søren from Copenhagen', 2, 'Pearl White'], ['Alessia from Milan', 0, 'Ash Pink'],
  ['Kofi from London', 4, 'Black'], ['Anouk from Rotterdam', 1, 'Moss Green'],
  ['Matteo from Zurich', 5, 'Rose Gold'], ['Zofia from Warsaw', 3, 'Pearl White'],
  ['Émile from Lyon', 0, 'Moss Green'], ['Ingrid from Stockholm', 1, 'Pearl White'],
  ['Luca from Vienna', 2, 'Pearl White'], ['Aitana from Madrid', 0, 'Pearl White'],
  ['Jamal from Berlin', 4, 'White'], ['Saoirse from Dublin', 5, 'Rose Gold']
];
const toast = document.getElementById('toast');
let bi = 0;
function showToast() {
  const [name, pidx, color] = BUYERS[bi % BUYERS.length]; bi++;
  const p = PRODUCTS[pidx];
  const mins = 1 + Math.floor(Math.random() * 11);
  const col = p.colors.find(c => c.n === color) || p.colors[0];
  document.getElementById('toastName').textContent = name;
  document.getElementById('toastDetail').textContent = `bought ${p.name} · ${col.n} — ${mins} min ago`;
  document.getElementById('toastImg').src = col.img + '&width=200';
  toast.classList.add('show');
  setTimeout(() => toast.classList.remove('show'), 5200);
}
setTimeout(showToast, 7000);
setInterval(showToast, 15000);

/* ---- hero parallax (clean, no 3D) ---- */
const heroFrame = document.getElementById('heroFrame');
const heroImg = document.getElementById('heroImg');
if (matchMedia('(pointer:fine)').matches) {
  const hs = document.querySelector('.hero');
  hs.addEventListener('mousemove', e => {
    const r = hs.getBoundingClientRect();
    const x = (e.clientX - r.left) / r.width - .5;
    const y = (e.clientY - r.top) / r.height - .5;
    heroFrame.style.transform = `translate(${x * -10}px, ${y * -8}px)`;
    heroImg.style.transform = `scale(1.06) translate(${x * 14}px, ${y * 10}px)`;
    document.querySelectorAll('[data-depth]').forEach(el => { el.style.translate = `${x * +el.dataset.depth}px ${y * +el.dataset.depth}px`; });
  });
  hs.addEventListener('mouseleave', () => { heroFrame.style.transform = ''; heroImg.style.transform = ''; });
}

/* ---- specs visual scroll FX ---- */
const specsTilt = document.getElementById('specsTilt');
const specsImg = specsTilt ? specsTilt.querySelector('img') : null;
let specsHover = false;
function specsScrollFX() {
  if (!specsTilt || specsHover) return;
  const r = specsTilt.getBoundingClientRect(); const vh = window.innerHeight;
  const p = Math.min(1, Math.max(0, (vh * .9 - r.top) / (vh * .75)));
  specsTilt.style.transform = `perspective(1000px) rotateY(${(1 - p) * 24}deg) scale(${.9 + p * .1})`;
  specsTilt.style.opacity = .25 + p * .75;
  if (specsImg) specsImg.style.transform = `translateY(${(1 - p) * 36}px)`;
  specsTilt.querySelector('.specs__shine').style.setProperty('--shx', (120 - p * 70) + '%');
}
specsScrollFX();
window.addEventListener('scroll', () => requestAnimationFrame(specsScrollFX), { passive: true });
window.addEventListener('resize', specsScrollFX);
if (specsTilt && matchMedia('(pointer:fine)').matches) {
  specsTilt.addEventListener('mouseenter', () => { specsHover = true; });
  specsTilt.addEventListener('mousemove', e => {
    const r = specsTilt.getBoundingClientRect();
    const x = (e.clientX - r.left) / r.width - .5;
    const y = (e.clientY - r.top) / r.height - .5;
    specsTilt.style.transform = `perspective(900px) rotateY(${x * 8}deg) rotateX(${-y * 8}deg) scale(1)`;
    specsTilt.querySelector('.specs__shine').style.setProperty('--shx', (50 + x * 120) + '%');
  });
  specsTilt.addEventListener('mouseleave', () => { specsHover = false; specsScrollFX(); });
}

/* ---- scroll reveal ---- */
const io = new IntersectionObserver(entries => {
  entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
}, { threshold: 0.12 });
document.querySelectorAll('.reveal, h2').forEach(el => io.observe(el));
</script>
</body>
</html>

