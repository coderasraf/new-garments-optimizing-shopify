    <p class="text-subtle text-[10px] tracking-wide">free worldwide shipping · ships in 48h</p>
    <p class="text-subtle text-[10px] tracking-wide">secure checkout · easy returns</p>
  </div>

  <div class="text-center mt-12 reveal">
    <p class="text-muted text-[11px] italic">"the fit starts with the right pair."</p>
    <p class="text-subtle text-[9px] tracking-[.3em] mt-4 uppercase">newgarments™</p>
  </div>
</section>

<!-- STICKY CTA -->
<div class="sticky-cta" id="stickyCta">
  <button onclick="addBundleToCart()" class="flex items-center justify-between w-full bg-fg text-bg px-5 py-3.5 tap-feedback border-none cursor-pointer">
    <div>
      <span class="font-black text-[15px]">$66.95</span>
      <span class="line-through text-bg/40 text-[11px] ml-1.5">$151</span>
    </div>
    <span class="bg-lime text-fg font-bold text-[13px] px-4 py-2">secure the drop</span>
  </button>
</div>

<!-- ============================================= -->
<!-- JAVASCRIPT -->
<!-- ============================================= -->
<script>
// ──── VARIANT MAP: color → size → variant ID ────
const variants = {
  blue:  { 36:56521115664761, 37:56521115697529, 38:56521115730297, 39:56521115763065, 40:56521115795833, 41:56521115828601, 42:56521115861369, 43:56521115894137, 44:56521115926905, 45:56521115959673 },
  pink:  { 36:56521115992441, 37:56521116025209, 38:56521116057977, 39:56521116090745, 40:56521116123513, 41:56521116156281, 42:56521116189049, 43:56521116221817, 44:56521116254585, 45:56521116287353 },
  white: { 36:56521116320121, 37:56521116352889, 38:56521116385657, 39:56521116418425, 40:56521116451193, 41:56521116483961, 42:56521116516729, 43:56521116549497, 44:56521116582265, 45:56521116615033 },
  green: { 36:56521116647801, 37:56521116680569, 38:56521116713337, 39:56521116746105, 40:56521116778873, 41:56521116811641, 42:56521116844409, 43:56521116877177, 44:56521116909945, 45:56521116942713 }
};

// Default free gift variants (first available variant of each)
const giftVariants = {
  belt:   56349372776825,  // Silvery / 110cm
  beanie: 56349647536505,  // Black
  ring:   56349678436729   // Size 9
};

let selectedColor = 'blue';
let selectedSize = '40';

// ──── ADD BUNDLE TO CART via Shopify /cart/add.js ────
async function addBundleToCart() {
  const sneakerVariant = variants[selectedColor]?.[selectedSize];
  if (!sneakerVariant) { alert('select a size and color'); return; }

  // Disable all CTAs during loading
  document.querySelectorAll('.tap-feedback, .cta-pulse').forEach(el => el.classList.add('cta-loading'));

  try {
    const response = await fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        items: [
          { id: sneakerVariant, quantity: 1 },
          { id: giftVariants.belt, quantity: 1 },
          { id: giftVariants.beanie, quantity: 1 },
          { id: giftVariants.ring, quantity: 1 }
        ]
      })
    });

    if (response.ok) {
      // Redirect to checkout
      window.location.href = '/checkout';
    } else {
      alert('something went wrong. try again.');
    }
  } catch (e) {
    alert('something went wrong. try again.');
  }

  document.querySelectorAll('.cta-loading').forEach(el => el.classList.remove('cta-loading'));
}

// ──── GSAP ────
gsap.registerPlugin(ScrollTrigger);

window.addEventListener('scroll', () => {
  const h = document.documentElement.scrollHeight - window.innerHeight;
  document.getElementById('progressBar').style.width = (window.scrollY / h * 100) + '%';
});

gsap.utils.toArray('.reveal').forEach(el => {
  gsap.to(el, { opacity: 1, y: 0, duration: .8, ease: 'power2.out', scrollTrigger: { trigger: el, start: 'top 85%', once: true } });
});
gsap.utils.toArray('.reveal-left').forEach(el => {
  gsap.to(el, { opacity: 1, x: 0, duration: .7, ease: 'power2.out', scrollTrigger: { trigger: el, start: 'top 85%', once: true } });
});
gsap.utils.toArray('.reveal-right').forEach(el => {
  gsap.to(el, { opacity: 1, x: 0, duration: .7, ease: 'power2.out', scrollTrigger: { trigger: el, start: 'top 85%', once: true } });
});
gsap.utils.toArray('.gift-card').forEach((el, i) => {
  gsap.to(el, { opacity: 1, x: 0, rotation: 0, duration: .6, delay: i * .1, ease: 'power3.out', scrollTrigger: { trigger: el, start: 'top 85%', once: true } });
});

ScrollTrigger.create({ trigger: '#savingsBadge', start: 'top 85%', once: true,
  onEnter: () => document.getElementById('savingsBadge').classList.add('pop-in')
});

document.querySelectorAll('.counter[data-target]').forEach(el => {
  const target = parseInt(el.dataset.target);
  ScrollTrigger.create({ trigger: el, start: 'top 85%', once: true, onEnter: () => {
    const duration = target > 1000 ? 2000 : 1200; const start = Date.now();
    const tick = () => { const p = Math.min((Date.now()-start)/duration,1); el.textContent = Math.floor((1-Math.pow(1-p,3))*target).toLocaleString(); if(p<1) requestAnimationFrame(tick); };
    requestAnimationFrame(tick);
  }});
});

const stickyCta = document.getElementById('stickyCta');
ScrollTrigger.create({ trigger: '#hero', start: 'bottom top', endTrigger: '#buy', end: 'top 80%',
  onEnter: () => stickyCta.classList.add('visible'), onLeaveBack: () => stickyCta.classList.remove('visible'),
  onLeave: () => stickyCta.classList.remove('visible'), onEnterBack: () => stickyCta.classList.add('visible'),
});

// ──── COLOR CAROUSEL ────
const carousel = document.getElementById('colorCarousel');
const dots = document.querySelectorAll('#colorDots .color-dot');
const colorNames = ['blue','pink','white','green'];

carousel.addEventListener('scroll', () => {
  const idx = Math.round(carousel.scrollLeft / (carousel.children[0].offsetWidth + 16));
  if (colorNames[idx] && colorNames[idx] !== selectedColor) {
    selectedColor = colorNames[idx];
    dots.forEach((d, i) => d.classList.toggle('active', i === idx));
    // Sync buy section color dots
    document.querySelectorAll('#buyColorDots .color-dot').forEach(d => d.classList.toggle('active', d.dataset.color === selectedColor));
    if (navigator.vibrate) navigator.vibrate(5);
  }
});

dots.forEach((dot, i) => {
  dot.addEventListener('click', () => {
    carousel.scrollTo({ left: (carousel.children[0].offsetWidth + 16) * i, behavior: 'smooth' });
    if (navigator.vibrate) navigator.vibrate(10);
  });
});

// ──── SIZE SELECTOR ────
document.querySelectorAll('.size-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('.size-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    selectedSize = btn.dataset.size;
    if (navigator.vibrate) navigator.vibrate(10);
  });
});

// ──── BUY COLOR DOTS ────
document.querySelectorAll('#buyColorDots .color-dot').forEach(dot => {
  dot.addEventListener('click', () => {
    document.querySelectorAll('#buyColorDots .color-dot').forEach(d => d.classList.remove('active'));
    dot.classList.add('active');
    selectedColor = dot.dataset.color;
    // Sync carousel
    const idx = colorNames.indexOf(selectedColor);
    if (idx >= 0) carousel.scrollTo({ left: (carousel.children[0].offsetWidth + 16) * idx, behavior: 'smooth' });
    if (navigator.vibrate) navigator.vibrate(10);
  });
});

// ──── HAPTIC ────
document.querySelectorAll('.tap-feedback').forEach(el => {
  el.addEventListener('touchstart', () => { if (navigator.vibrate) navigator.vibrate(15); });
});
</script>
{% endraw %}
</body>
</html>
