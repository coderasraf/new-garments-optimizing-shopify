<script>
tailwind.config = {
  theme: {
    extend: {
      colors: {
        "bg": "#f5f5f0",
        "fg": "#0a0a0a",
        "muted": "#71717a",
        "subtle": "#a1a1aa",
        "lime": "#c8ff00",
        "surface": "#e8e8e4",
      },
      fontFamily: {
        "sans": ["Inter", "system-ui", "sans-serif"],
        "display": ["Space Grotesk", "sans-serif"],
      }
    }
