<div class="top-progress" id="topProgress" style="width:0%"></div>

<script>
const slides = document.querySelectorAll('.slide');
const topProgress = document.getElementById('topProgress');
let current = 0, transitioning = false;

function goTo(idx) {
  if (idx < 0 || idx >= slides.length || idx === current || transitioning) return;
  transitioning = true;
  const prev = current; current = idx;
  slides[prev].classList.add('slide--exit');
  slides[prev].classList.remove('slide--active');
  setTimeout(function() {
    slides[prev].classList.remove('slide--exit');
    slides[idx].classList.add('slide--active');
    slides[idx].querySelectorAll('.reveal').forEach(function(el) { el.classList.add('visible'); });
    transitioning = false;
  }, 150);
  topProgress.style.width = ((idx + 1) / slides.length * 100) + '%';
  if (navigator.vibrate) navigator.vibrate(10);
  if (idx === 7) resetSlider();
}

var slider = document.getElementById('priceSlider'), label = document.getElementById('sliderLabel'), fill = document.getElementById('sliderFill');
function updateSlider() { if (!slider) return; fill.style.width = ((slider.value-20)/79*100)+'%'; label.textContent = '\u20AC'+slider.value+'/mo'; }
function resetSlider() { if (!slider) return; slider.value = 49; updateSlider(); }
if (slider) slider.addEventListener('input', function() { updateSlider(); if (navigator.vibrate) navigator.vibrate(5); });

document.querySelectorAll('.slide-next').forEach(function(b) { b.addEventListener('click', function(e) { e.preventDefault(); goTo(current+1); }); });

var ce = document.getElementById('countdown');
if (ce) {
  var et = localStorage.getItem('vault_countdown_v3');
  if (!et) { et = String(Date.now() + 17*3600000); localStorage.setItem('vault_countdown_v3', et); }
  function uc() { var d=Math.max(0,Number(et)-Date.now()), h=Math.floor(d/3600000), m=Math.floor(d%3600000/60000), s=Math.floor(d%60000/1000); ce.textContent=String(h).padStart(2,'0')+':'+String(m).padStart(2,'0')+':'+String(s).padStart(2,'0'); }
  uc(); setInterval(uc,1000);
}

slides[0].classList.add('slide--active');
slides[0].querySelectorAll('.reveal').forEach(function(el) { el.classList.add('visible'); });
topProgress.style.width = (100/slides.length)+'%';

// Vault checkout — add subscription to cart with selling plan
function addVaultToCart() {
  fetch('/cart/add.js', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({
      items: [{
        id: 56923884585337,
        quantity: 1,
        selling_plan: 712429830521
      }]
    })
  }).then(function(res) {
    if (res.ok) { window.location.href = '/checkout'; }
    else { alert('something went wrong. try again.'); }
  }).catch(function() { alert('something went wrong. try again.'); });
}
</script>
