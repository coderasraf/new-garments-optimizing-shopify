<style>
  .material-symbols-outlined { font-variation-settings: 'FILL' 1, 'wght' 400, 'GRAD' 0, 'opsz' 24; font-size: 14px; }
  html, body { height: 100%; overflow: hidden; background: #0a0a0a; color: #fff; font-family: 'Inter', sans-serif; -webkit-font-smoothing: antialiased; text-transform: lowercase; }
  .slide { position: fixed; inset: 0; width: 100%; height: 100%; display: flex; flex-direction: column; opacity: 0; pointer-events: none; transform: translateY(30px) scale(0.98); transition: opacity .5s ease, transform .5s ease; z-index: 1; overflow: hidden; }
  .slide--active { opacity: 1; pointer-events: auto; z-index: 2; transform: none; }
  .slide--exit { opacity: 0; transform: translateY(-30px) scale(0.98); }
  .slide-inner { display: flex; flex-direction: column; justify-content: center; gap: 2.5vh; height: 100%; width: 100%; max-width: 28rem; margin: 0 auto; padding: 2vh 1.25rem; overflow: hidden; }
  .reveal { opacity: 0; transform: translateY(16px); transition: opacity .4s ease, transform .4s ease; }
  .reveal.visible { opacity: 1; transform: none; }
  .reveal-d1 { transition-delay: .08s; } .reveal-d2 { transition-delay: .16s; } .reveal-d3 { transition-delay: .24s; } .reveal-d4 { transition-delay: .32s; } .reveal-d5 { transition-delay: .4s; }
  @keyframes glow { 0%,100% { box-shadow: 0 0 12px rgba(200,255,0,.15), 0 0 24px rgba(200,255,0,.08); } 50% { box-shadow: 0 0 24px rgba(200,255,0,.5), 0 0 48px rgba(200,255,0,.25), 0 0 72px rgba(200,255,0,.1); } }
  .cta-glow { animation: glow 2s ease-in-out infinite; }
  @keyframes valueGlow { 0%,100% { box-shadow: 0 0 8px rgba(200,255,0,.15); } 50% { box-shadow: 0 0 20px rgba(200,255,0,.45), 0 0 40px rgba(200,255,0,.15); } }
  .value-glow { animation: valueGlow 2.5s ease-in-out infinite; }
  @keyframes limeGlow { 0%,100% { text-shadow: 0 0 4px rgba(200,255,0,.15); } 50% { text-shadow: 0 0 14px rgba(200,255,0,.5), 0 0 24px rgba(200,255,0,.2); } }
  .lime-glow { animation: limeGlow 2s ease-in-out infinite; }
  @keyframes starPulse { 0%,100% { text-shadow: 0 0 3px rgba(200,255,0,.2); } 50% { text-shadow: 0 0 10px rgba(200,255,0,.7); } }
  .star-glow { animation: starPulse 2s ease-in-out infinite; }
  @keyframes borderGlow { 0%,100% { border-color: rgba(200,255,0,.15); } 50% { border-color: rgba(200,255,0,.5); box-shadow: 0 0 12px rgba(200,255,0,.1); } }
  .border-glow { animation: borderGlow 2.5s ease-in-out infinite; }
  @keyframes countdownPulse { 0%,100% { opacity: 1; } 50% { opacity: .5; } }
  .countdown-pulse { animation: countdownPulse 1.5s ease-in-out infinite; }
  @keyframes ping { 75%,100% { transform: scale(2); opacity: 0; } }
  .urgency-ping { position: relative; }
  .urgency-ping::after { content:''; position:absolute; inset:0; border-radius:50%; background:#c8ff00; animation: ping 1.5s cubic-bezier(0,0,.2,1) infinite; }
  .top-progress { position:fixed; top:0; left:0; height:2px; background:#c8ff00; z-index:300; transition: width .5s ease; }
  input[type=range] { -webkit-appearance:none; width:100%; background:transparent; }
  input[type=range]:focus { outline:none; }
  input[type=range]::-webkit-slider-runnable-track { height:2px; background:#27272a; }
  input[type=range]::-webkit-slider-thumb { -webkit-appearance:none; width:32px; height:32px; border-radius:50%; background:#c8ff00; margin-top:-15px; border:3px solid #0a0a0a; box-shadow: 0 0 12px rgba(200,255,0,.4); }
  input[type=range]::-moz-range-track { height:2px; background:#27272a; border:none; }
  input[type=range]::-moz-range-thumb { width:32px; height:32px; border-radius:50%; background:#c8ff00; border:3px solid #0a0a0a; box-shadow: 0 0 12px rgba(200,255,0,.4); }
  .dim-text { color: rgba(255,255,255,.35); }
</style>
</head>
