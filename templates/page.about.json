{"sections":{"main":{"type":"main-page","disabled":true,"settings":{}},"slideshow":{"type":"slideshow","blocks":{"slideshow-0":{"type":"image","settings":{"video_url":"","video_url_mobile":"","top_subheading":"","badge_text":"70% OFF","badge_bg":"#ed4f31","badge_color":"#ffffff","title":"Not just clothing — a statement of identity.","title_size":50,"subheading":"","check_text1":"Clean fit. Heavyweight fabric. Everyday gear designed to last.","check_text2":"Spend £130 to enter the giveaway for a $5,000 New York trip for 2","rating_text":"Rated 4.9.\/5 by 200,000+ customers.","link":"","link_text":"","link_2":"","link_text_2":"","color_accent":"rgba(0,0,0,0)","text_align":"vertical-center horizontal-center","parallax_direction":"top","overlay_opacity":0}}},"block_order":["slideshow-0"],"disabled":true,"settings":{"section_height":"650px","mobile_height":"auto","parallax":true,"style":"bars","autoplay":true,"autoplay_speed":7,"lazyload_images":true}},"rich_text_4p7Ana":{"type":"rich-text","blocks":{"text_zMBGKG":{"type":"text","settings":{"enlarge_text":true,"text":"<p><strong>About \"<\/strong><em><strong>NEWGARMENTS<\/strong><\/em><strong>\" - <\/strong><br\/><br\/>NEWGARMENTS is built for people who move with intent.<br\/><br\/>Style isn’t decoration — it’s presence.<\/p><p>Every piece is designed to feel natural on you and unmistakable to everyone else.<br\/><br\/>Clean silhouettes, solid construction, and a fit that holds its shape the moment you step into a room.<\/p><h3>WHAT WE MAKE<\/h3><p>We focus on essential streetwear.<br\/><br\/>Each item is developed with attention to fit, fabric quality, and long-term wear.<\/p><p>Our collections include tees, hoodies, pants, jackets, footwear, and accessories — designed to work together, not to chase trends.<\/p><p>Made for everyday use, wherever the day takes you.<br\/><br\/>NEWGARMENTS is for people who trust their own taste and don’t rely on validation.<\/p><h3>WHERE WE OPERATE<\/h3><p>NEWGARMENTS operates from the USA and ships worldwide.<br\/><br\/>All orders are processed with fast, trackable delivery.<\/p><p>No fast fashion. No empty hype.<br\/><br\/>Just well-made pieces built with consistency, intention, and durability.<\/p>"}}},"block_order":["text_zMBGKG"],"name":"t:sections.rich-text.presets.rich_text.name","settings":{"align_text":"center","narrow_column":true,"divider":false}},"rich_text_reVxgH":{"type":"rich-text","blocks":{"heading_zUrEHh":{"type":"heading","settings":{"title":"WHY OUR CUSTOMERS TRUST US"}},"text_V3f9PB":{"type":"text","settings":{"enlarge_text":true,"text":"<p>NEWGARMENTS is built alongside the people who wear it.<br\/><br\/>Every release is refined through real feedback and real use.<\/p><p>We operate transparently and take responsibility for every order.<br\/><br\/>That means responsive customer support, secure payment methods, and fast, fully trackable shipping.<\/p><p>With each drop, we improve — applying what we’ve learned to deliver more consistent quality, better fit, and a smoother overall experience.<\/p><p>No shortcuts. No guesswork. Just reliability you can feel.<\/p>"}}},"block_order":["heading_zUrEHh","text_V3f9PB"],"name":"t:sections.rich-text.presets.rich_text.name","settings":{"align_text":"center","narrow_column":true,"divider":false}},"rich_text_peyERp":{"type":"rich-text","blocks":{"heading_Xp8GdY":{"type":"heading","settings":{"title":"Business details"}},"text_AUbeGR":{"type":"text","settings":{"enlarge_text":true,"text":"<p><strong>Business Hours<\/strong><br\/>Monday – Friday: 9:00 AM – 6:00 PM (GMT−6)<br\/>Saturday and Sunday: Closed<br\/>Public Holidays: Closed<\/p><p>Address: H.W. Mesdagstraat 21A, 9718HB, GR, NL<br\/>Email: support@newgarments.store<br\/>Phone: +19033192501<\/p>"}}},"block_order":["heading_Xp8GdY","text_AUbeGR"],"name":"t:sections.rich-text.presets.rich_text.name","settings":{"align_text":"center","narrow_column":true,"divider":false}},"instafeed_WJ6NE9":{"type":"instafeed","blocks":{"image_XxAL6Y":{"typ