{% doc %}
  @prompt
    create a blog like section optimized for mobile view, where i can add an image with a bit of context and a small place to link an item and the date that i can change 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-blog-card-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }

  .ai-blog-card__image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background-color: #f4f4f4;
  }

  .ai-blog-card__image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-blog-card__image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f4f4f4;
  }

  .ai-blog-card__image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 200px;
    max-height: 200px;
  }

  .ai-blog-card__content-{{ ai_gen_id }} {
    padding: {{ block.settings.content_padding }}px;
  }

  .ai-blog-card__date-{{ ai_gen_id }} {
    font-size: {{ block.settings.date_font_size }}px;
    color: {{ block.settings.date_color }};
    margin-bottom: 8px;
    display: block;
  }

  .ai-blog-card__text-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_font_size }}px;
    color: {{ block.settings.text_color }};
    line-height: 1.5;
    margin-bottom: 16px;
  }

  .ai-blog-card__link-wrapper-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: {{ block.settings.link_padding }}px;
    background-color: {{ block.settings.link_background_color }};
    border-radius: {{ block.settings.link_border_radius }}px;
    text-decoration: none;
    transition: background-color 0.3s ease;
  }

  .ai-blog-card__link-wrapper-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.link_hover_background_color }};
  }

  .ai-blog-card__product-image-{{ ai_gen_id }} {
    width: {{ block.settings.product_image_size }}px;
    height: {{ block.settings.product_image_size }}px;
    flex-shrink: 0;
    border-radius: 4px;
    overflow: hidden;
  }

  .ai-blog-card__product-image-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-blog-card__product-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #e8e8e8;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-blog-card__product-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
  }

  .ai-blog-card__product-info-{{ ai_gen_id }} {
    flex-grow: 1;
    min-width: 0;
  }

  .ai-blog-card__product-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_title_font_size }}px;
    color: {{ block.settings.product_title_color }};
    margin: 0 0 4px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .ai-blog-card__product-price-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_price_font_size }}px;
    color: {{ block.settings.product_price_color }};
    font-weight: 600;
  }

  .ai-blog-card__empty-product-{{ ai_gen_id }} {
    font-size: 13px;
    color: #999;
    font-style: italic;
    text-align: center;
    padding: 12px;
  }

  @media screen and (max-width: 749px) {
    .ai-blog-card__content-{{ ai_gen_id }} {
      padding: {{ block.settings.content_padding | times: 0.8 }}px;
    }

    .ai-blog-card__text-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_font_size | times: 0.9 }}px;
    }

    .ai-blog-card__product-image-{{ ai_gen_id }} {
      width: {{ block.settings.product_image_size | times: 0.8 }}px;
      height: {{ block.settings.product_image_size | times: 0.8 }}px;
    }
  }
{% endstyle %}

<div
  class="ai-blog-card-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-blog-card__image-wrapper-{{ ai_gen_id }}">
    {% if block.settings.image %}
      <img
        src="{{ block.settings.image | image_url: width: 800 }}"
        alt="{{ block.settings.image.alt | escape }}"
        loading="lazy"
        width="{{ block.settings.image.width }}"
        height="{{ block.settings.image.height }}"
        class="ai-blog-card__image-{{ ai_gen_id }}"
      >
    {% else %}
      <div class="ai-blog-card__image-placeholder-{{ ai_gen_id }}">
        {{ 'image' | placeholder_svg_tag }}
      </div>
    {% endif %}
  </div>

  <div class="ai-blog-card__content-{{ ai_gen_id }}">
    {% if block.settings.date != blank %}
      <span class="ai-blog-card__date-{{ ai_gen_id }}">{{ block.settings.date }}</span>
    {% endif %}

    {% if block.settings.text != blank %}
      <div class="ai-blog-card__text-{{ ai_gen_id }}">{{ block.settings.text }}</div>
    {% endif %}

    {% if block.settings.product != blank %}
      <a
        href="{{ block.settings.product.url }}"
        class="ai-blog-card__link-wrapper-{{ ai_gen_id }}"
      >
        <div class="ai-blog-card__product-image-{{ ai_gen_id }}">
          {% if block.settings.product.featured_image %}
            <img
              src="{{ block.settings.product.featured_image | image_url: width: 200 }}"
              alt="{{ block.settings.product.featured_image.alt | escape }}"
              width="200"
              height="200"
              loading="lazy"
            >
          {% else %}
            <div class="ai-blog-card__product-placeholder-{{ ai_gen_id }}">
              {{ 'product-1' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </div>
        <div class="ai-blog-card__product-info-{{ ai_gen_id }}">
          <h3 class="ai-blog-card__product-title-{{ ai_gen_id }}">{{ block.settings.product.title }}</h3>
          <div class="ai-blog-card__product-price-{{ ai_gen_id }}">{{ block.settings.product.price | money }}</div>
        </div>
      </a>
    {% else %}
      <div class="ai-blog-card__link-wrapper-{{ ai_gen_id }}">
        <div class="ai-blog-card__empty-product-{{ ai_gen_id }}">
          Add a product to link
        </div>
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Blog card",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "date",
      "label": "Date",
      "default": "January 16, 2026"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Share your thoughts, updates, or featured content here. Keep it short and engaging for mobile readers."
    },
    {
      "type": "header",
      "content": "Linked product"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Product"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "label": "Border radius",
      "default": 8
    },
    {
      "type": "range",
      "id": "content_padding",
      "min": 10,
      "max": 40,
      "step": 5,
      "unit": "px",
      "label": "Content padding",
      "default": 20
    },
    {
      "type": "header",
      "content": "Date style"
    },
    {
      "type": "range",
      "id": "date_font_size",
      "min": 10,
      "max": 18,
      "step": 1,
      "unit": "px",
      "label": "Font size",
      "default": 12
    },
    {
      "type": "color",
      "id": "date_color",
      "label": "Color",
      "default": "#666666"
    },
    {
      "type": "header",
      "content": "Text style"
    },
    {
      "type": "range",
      "id": "text_font_size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Font size",
      "default": 14
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Color",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Product link style"
    },
    {
      "type": "range",
      "id": "link_padding",
      "min": 8,
      "max": 20,
      "step": 2,
      "unit": "px",
      "label": "Padding",
      "default": 12
    },
    {
      "type": "range",
      "id": "link_border_radius",
      "min": 0,
      "max": 12,
      "step": 2,
      "unit": "px",
      "label": "Border radius",
      "default": 6
    },
    {
      "type": "color",
      "id": "link_background_color",
      "label": "Background",
      "default": "#f4f4f4"
    },
    {
      "type": "color",
      "id": "link_hover_background_color",
      "label": "Hover background",
      "default": "#e8e8e8"
    },
    {
      "type": "range",
      "id": "product_image_size",
      "min": 40,
      "max": 80,
      "step": 5,
      "unit": "px",
      "label": "Product image size",
      "default": 60
    },
    {
      "type": "range",
      "id": "product_title_font_size",
      "min": 12,
      "max": 18,
      "step": 1,
      "unit": "px",
      "label": "Product title size",
      "default": 14
    },
    {
      "type": "color",
      "id": "product_title_color",
      "label": "Product title color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "product_price_font_size",
      "min": 11,
      "max": 16,
      "step": 1,
      "unit": "px",
      "label": "Product price size",
      "default": 13
    },
    {
      "type": "color",
      "id": "product_price_color",
      "label": "Product price color",
      "default": "#d90029"
    }
  ],
  "presets": [
    {
      "name": "Blog card"
    }
  ]
}
{% endschema %}
