{% doc %}
  @prompt
    generate a time countdown with days:hours;Mins;seconds , make i way smaller it needs to fit the mobile view, make sure the timer is always on 2 hours and resets when it ends, invert the colors
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-countdown-timer-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.padding }}px;
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
    text-align: center;
  }

  .ai-countdown-timer__heading-{{ ai_gen_id }} {
    margin: 0 0 {{ block.settings.heading_spacing }}px;
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    font-weight: 700;
  }

  .ai-countdown-timer__display-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: {{ block.settings.unit_spacing }}px;
    flex-wrap: wrap;
  }

  .ai-countdown-timer__unit-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: {{ block.settings.unit_width }}px;
  }

  .ai-countdown-timer__value-{{ ai_gen_id }} {
    font-size: {{ block.settings.number_size }}px;
    font-weight: 700;
    color: {{ block.settings.number_color }};
    line-height: 1;
    margin-bottom: {{ block.settings.label_spacing }}px;
  }

  .ai-countdown-timer__label-{{ ai_gen_id }} {
    font-size: {{ block.settings.label_size }}px;
    color: {{ block.settings.label_color }};
    text-transform: {{ block.settings.label_uppercase }};
  }

  .ai-countdown-timer__separator-{{ ai_gen_id }} {
    font-size: {{ block.settings.number_size }}px;
    font-weight: 700;
    color: {{ block.settings.separator_color }};
    line-height: 1;
    align-self: flex-start;
    padding-top: 2px;
  }

  @media screen and (max-width: 749px) {
    .ai-countdown-timer-{{ ai_gen_id }} {
      padding: calc({{ block.settings.padding }}px * 0.5);
    }

    .ai-countdown-timer__heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.6);
      margin-bottom: calc({{ block.settings.heading_spacing }}px * 0.5);
    }

    .ai-countdown-timer__display-{{ ai_gen_id }} {
      gap: calc({{ block.settings.unit_spacing }}px * 0.4);
    }

    .ai-countdown-timer__value-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.number_size }}px * 0.5);
      margin-bottom: calc({{ block.settings.label_spacing }}px * 0.5);
    }

    .ai-countdown-timer__separator-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.number_size }}px * 0.5);
      padding-top: 1px;
    }

    .ai-countdown-timer__label-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.label_size }}px * 0.7);
    }

    .ai-countdown-timer__unit-{{ ai_gen_id }} {
      min-width: calc({{ block.settings.unit_width }}px * 0.5);
    }
  }
{% endstyle %}

<countdown-timer-{{ ai_gen_id }}
  class="ai-countdown-timer-{{ ai_gen_id }}"
  data-duration-hours="{{ block.settings.duration_hours }}"
  {{ block.shopify_attributes }}
>
  {% if block.settings.heading != blank %}
    <h2 class="ai-countdown-timer__heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
  {% endif %}

  <div class="ai-countdown-timer__display-{{ ai_gen_id }}" data-countdown-display>
    <div class="ai-countdown-timer__unit-{{ ai_gen_id }}">
      <div class="ai-countdown-timer__value-{{ ai_gen_id }}" data-days>00</div>
      <div class="ai-countdown-timer__label-{{ ai_gen_id }}">{{ block.settings.days_label }}</div>
    </div>

    <div class="ai-countdown-timer__separator-{{ ai_gen_id }}">{{ block.settings.separator }}</div>

    <div class="ai-countdown-timer__unit-{{ ai_gen_id }}">
      <div class="ai-countdown-timer__value-{{ ai_gen_id }}" data-hours>00</div>
      <div class="ai-countdown-timer__label-{{ ai_gen_id }}">{{ block.settings.hours_label }}</div>
    </div>

    <div class="ai-countdown-timer__separator-{{ ai_gen_id }}">{{ block.settings.separator }}</div>

    <div class="ai-countdown-timer__unit-{{ ai_gen_id }}">
      <div class="ai-countdown-timer__value-{{ ai_gen_id }}" data-minutes>00</div>
      <div class="ai-countdown-timer__label-{{ ai_gen_id }}">{{ block.settings.minutes_label }}</div>
    </div>

    <div class="ai-countdown-timer__separator-{{ ai_gen_id }}">{{ block.settings.separator }}</div>

    <div class="ai-countdown-timer__unit-{{ ai_gen_id }}">
      <div class="ai-countdown-timer__value-{{ ai_gen_id }}" data-seconds>00</div>
      <div class="ai-countdown-timer__label-{{ ai_gen_id }}">{{ block.settings.seconds_label }}</div>
    </div>
  </div>
</countdown-timer-{{ ai_gen_id }}>

<script>
  (function() {
    class CountdownTimer{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.durationHours = parseInt(this.dataset.durationHours) || 2;
        this.interval = null;
        this.storageKey = 'countdown-timer-{{ ai_gen_id }}-end';
      }

      connectedCallback() {
        this.daysElement = this.querySelector('[data-days]');
        this.hoursElement = this.querySelector('[data-hours]');
        this.minutesElement = this.querySelector('[data-minutes]');
        this.secondsElement = this.querySelector('[data-seconds]');
        this.displayElement = this.querySelector('[data-countdown-display]');

        this.initializeTimer();
        this.startCountdown();
      }

      disconnectedCallback() {
        if (this.interval) {
          clearInterval(this.interval);
        }
      }

      initializeTimer() {
        const storedEndTime = localStorage.getItem(this.storageKey);
        const now = new Date().getTime();

        if (storedEndTime && parseInt(storedEndTime) > now) {
          this.endTime = parseInt(storedEndTime);
        } else {
          this.resetTimer();
        }
      }

      resetTimer() {
        const now = new Date().getTime();
        this.endTime = now + (this.durationHours * 60 * 60 * 1000);
        localStorage.setItem(this.storageKey, this.endTime.toString());
      }

      startCountdown() {
        this.updateCountdown();
        this.interval = setInterval(() => {
          this.updateCountdown();
        }, 1000);
      }

      updateCountdown() {
        const now = new Date().getTime();
        const distance = this.endTime - now;

        if (distance < 0) {
          this.resetTimer();
          return;
        }

        const days = Math.floor(distance / (1000 * 60 * 60 * 24));
        const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
        const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
        const seconds = Math.floor((distance % (1000 * 60)) / 1000);

        this.daysElement.textContent = String(days).padStart(2, '0');
        this.hoursElement.textContent = String(hours).padStart(2, '0');
        this.minutesElement.textContent = String(minutes).padStart(2, '0');
        this.secondsElement.textContent = String(seconds).padStart(2, '0');
      }
    }

    customElements.define('countdown-timer-{{ ai_gen_id }}', CountdownTimer{{ ai_gen_id }});
  })();
</script>

