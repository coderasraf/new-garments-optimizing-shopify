{% doc %}
  @prompt
    generate a time countdown with days:hours;Mins;seconds , make i way smaller it needs to fit the mobile view, make sure the timer is always on 2 hours and resets when it ends ; make it use the UTC real time, so eveyry 2 real hours it resets, i need to be able to add a small header
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-countdown-timer-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.padding }}px;
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-countdown-timer__header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: {{ block.settings.header_spacing }}px;
  }

  .ai-countdown-timer__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.header_size }}px;
    font-weight: 700;
    color: {{ block.settings.header_color }};
    margin: 0;
    line-height: 1.2;
  }

  .ai-countdown-timer__wrapper-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: {{ block.settings.gap }}px;
  }

  .ai-countdown-timer__unit-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
  }

  .ai-countdown-timer__value-{{ ai_gen_id }} {
    font-size: {{ block.settings.number_size }}px;
    font-weight: 700;
    color: {{ block.settings.number_color }};
    line-height: 1;
    min-width: {{ block.settings.number_size | times: 1.2 }}px;
    text-align: center;
  }

  .ai-countdown-timer__label-{{ ai_gen_id }} {
    font-size: {{ block.settings.label_size }}px;
    color: {{ block.settings.label_color }};
    text-transform: uppercase;
    letter-spacing: 0.5px;
    line-height: 1;
  }

  .ai-countdown-timer__separator-{{ ai_gen_id }} {
    font-size: {{ block.settings.number_size }}px;
    font-weight: 700;
    color: {{ block.settings.separator_color }};
    line-height: 1;
    padding-bottom: {{ block.settings.label_size | plus: 4 }}px;
  }

  @media screen and (max-width: 749px) {
    .ai-countdown-timer__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.header_size | times: 0.8 }}px;
    }

    .ai-countdown-timer__value-{{ ai_gen_id }} {
      font-size: {{ block.settings.number_size | times: 0.8 }}px;
      min-width: {{ block.settings.number_size | times: 0.96 }}px;
    }

    .ai-countdown-timer__label-{{ ai_gen_id }} {
      font-size: {{ block.settings.label_size | times: 0.8 }}px;
    }

    .ai-countdown-timer__separator-{{ ai_gen_id }} {
      font-size: {{ block.settings.number_size | times: 0.8 }}px;
      padding-bottom: {{ block.settings.label_size | times: 0.8 | plus: 4 }}px;
    }
  }
{% endstyle %}

<countdown-timer-{{ ai_gen_id }} class="ai-countdown-timer-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.header_text != blank %}
    <div class="ai-countdown-timer__header-{{ ai_gen_id }}">
      <h3 class="ai-countdown-timer__title-{{ ai_gen_id }}">{{ block.settings.header_text }}</h3>
    </div>
  {% endif %}
  
  <div class="ai-countdown-timer__wrapper-{{ ai_gen_id }}">
    <div class="ai-countdown-timer__unit-{{ ai_gen_id }}">
      <div class="ai-countdown-timer__value-{{ ai_gen_id }}" data-days>00</div>
      <div class="ai-countdown-timer__label-{{ ai_gen_id }}">{{ block.settings.days_label }}</div>
    </div>
    <div class="ai-countdown-timer__separator-{{ ai_gen_id }}">{{ block.settings.separator }}</div>
    <div class="ai-countdown-timer__unit-{{ ai_gen_id }}">
      <div class="ai-countdown-timer__value-{{ ai_gen_id }}" data-hours>00</div>
      <div class="ai-countdown-timer__label-{{ ai_gen_id }}">{{ block.settings.hours_label }}</div>
    </div>
    <div class="ai-countdown-timer__separator-{{ ai_gen_id }}">{{ block.settings.separator }}</div>
    <div class="ai-countdown-timer__unit-{{ ai_gen_id }}">
      <div class="ai-countdown-timer__value-{{ ai_gen_id }}" data-minutes>00</div>
      <div class="ai-countdown-timer__label-{{ ai_gen_id }}">{{ block.settings.minutes_label }}</div>
    </div>
    <div class="ai-countdown-timer__separator-{{ ai_gen_id }}">{{ block.settings.separator }}</div>
    <div class="ai-countdown-timer__unit-{{ ai_gen_id }}">
      <div class="ai-countdown-timer__value-{{ ai_gen_id }}" data-seconds>00</div>
      <div class="ai-countdown-timer__label-{{ ai_gen_id }}">{{ block.settings.seconds_label }}</div>
    </div>
  </div>
</countdown-timer-{{ ai_gen_id }}>

<script>
  (function() {
    class CountdownTimer{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.daysEl = this.querySelector('[data-days]');
        this.hoursEl = this.querySelector('[data-hours]');
        this.minutesEl = this.querySelector('[data-minutes]');
        this.secondsEl = this.querySelector('[data-seconds]');
        this.interval = null;
      }

      connectedCallback() {
        this.startCountdown();
      }

      disconnectedCallback() {
        if (this.interval) {
          clearInterval(this.interval);
        }
      }

      getNextResetTime() {
        const now = new Date();
        const currentUTCHours = now.getUTCHours();
        const currentUTCMinutes = now.getUTCMinutes();
        const currentUTCSeconds = now.getUTCSeconds();
        const currentUTCMilliseconds = now.getUTCMilliseconds();

        const totalCurrentMinutes = currentUTCHours * 60 + currentUTCMinutes;
        const cyclesSinceStartOfDay = Math.floor(totalCurrentMinutes / 120);
        const nextCycleMinutes = (cyclesSinceStartOfDay + 1) * 120;

        const nextResetHours = Math.floor(nextCycleMinutes / 60) % 24;
        const nextResetMinutes = nextCycleMinutes % 60;

        const nextReset = new Date(Date.UTC(
          now.getUTCFullYear(),
          now.getUTCMonth(),
          now.getUTCDate(),
          nextResetHours,
          nextResetMinutes,
          0,
          0
        ));

        if (nextReset <= now) {
          nextReset.setUTCDate(nextReset.getUTCDate() + 1);
        }

        return nextReset;
      }

      updateCountdown() {
        const now = new Date();
        const targetTime = this.getNextResetTime();
        const diff = targetTime - now;

        if (diff <= 0) {
          this.daysEl.textContent = '00';
          this.hoursEl.textContent = '00';
          this.minutesEl.textContent = '00';
          this.secondsEl.textContent = '00';
          return;
        }

        const days = Math.floor(diff / (1000 * 60 * 60 * 24));
        const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
        const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
        const seconds = Math.floor((diff % (1000 * 60)) / 1000);

        this.daysEl.textContent = String(days).padStart(2, '0');
        this.hoursEl.textContent = String(hours).padStart(2, '0');
        this.minutesEl.textContent = String(minutes).padStart(2, '0');
        this.secondsEl.textContent = String(seconds).padStart(2, '0');
      }

      startCountdown() {
        this.updateCountdown();
        this.interval = setInterval(() => {
          this.updateCountdown();
        }, 1000);
      }
    }

    customElements.define('countdown-timer-{{ ai_gen_id }}', CountdownTimer{{ ai_gen_id }});
  })();
</script>

